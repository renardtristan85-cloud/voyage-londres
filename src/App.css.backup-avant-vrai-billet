/* =========================================================
   ANCIENNE ZONE VITE — NEUTRALISÉE
   ========================================================= */

.counter {
  font-size: 16px;
  padding: 5px 10px;
  border-radius: 5px;
  color: var(--accent, var(--vl-red));
  background: var(--accent-bg, transparent);
  border: 1px solid transparent;
  transition: border-color 0.2s ease;
  margin-bottom: 24px;
}

.counter:hover {
  border-color: var(--accent-border, var(--vl-red));
}

.hero {
  position: relative;
}

#center {
  display: flex;
  flex-direction: column;
  gap: 25px;
  place-content: center;
  place-items: center;
  flex-grow: 1;
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--vl-line);
  text-align: left;
}

#next-steps > div {
  flex: 1 1 0;
  padding: 32px;
}

#docs {
  border-right: 1px solid var(--vl-line);
}

#spacer {
  height: 88px;
  border-top: 1px solid var(--vl-line);
}

.ticks {
  position: relative;
  width: 100%;
}


/* =========================================================
   COUVERTURE — DOSSIER DE VOYAGE
   ========================================================= */

.voyage-cover {
  position: relative;
  overflow: hidden;
  isolation: isolate;

  min-height: 390px;

  padding: 34px 0 30px;

  background:
    radial-gradient(
      ellipse at 82% 18%,
      rgba(168, 148, 104, 0.12),
      transparent 30%
    ),
    radial-gradient(
      ellipse at 15% 82%,
      rgba(201, 204, 208, 0.06),
      transparent 35%
    ),
    linear-gradient(
      135deg,
      #0c1015 0%,
      #11171d 52%,
      #0b0f14 100%
    );

  border-bottom: 1px solid rgba(243, 241, 234, 0.12);
}

.voyage-cover::before {
  content: "";

  position: absolute;
  inset: 0;

  background:
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 5px,
      rgba(243, 241, 234, 0.014) 5px,
      rgba(243, 241, 234, 0.014) 6px
    );

  pointer-events: none;
}

.voyage-cover::after {
  content: "LONDON";

  position: absolute;
  right: -30px;
  bottom: -48px;

  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(110px, 19vw, 250px);
  font-weight: 600;
  line-height: 0.8;

  color: rgba(243, 241, 234, 0.025);

  pointer-events: none;
}

.voyage-cover-top {
  position: relative;
  z-index: 2;

  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 30px;
}

.voyage-kicker {
  display: flex;
  flex-direction: column;
  gap: 5px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  line-height: 1.4;
  letter-spacing: 2px;

  color: rgba(168, 148, 104, 0.85);
  text-transform: uppercase;
}

.voyage-kicker-number {
  color: rgba(243, 241, 234, 0.34);
}

.voyage-admin-button {
  padding: 7px 10px;

  border: 1px solid rgba(243, 241, 234, 0.15);
  background: rgba(243, 241, 234, 0.025);

  color: rgba(243, 241, 234, 0.48);

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 1px;

  cursor: pointer;

  transition:
    color 0.2s ease,
    border-color 0.2s ease,
    background 0.2s ease;
}

.voyage-admin-button:hover {
  color: var(--vl-paper);
  border-color: rgba(168, 148, 104, 0.55);
  background: rgba(168, 148, 104, 0.06);
}

.voyage-cover-main {
  position: relative;
  z-index: 2;

  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  gap: 45px;

  align-items: end;

  margin-top: 65px;
}

.voyage-cover-title {
  min-width: 0;
}

.voyage-cover-eyebrow {
  margin-bottom: 12px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 3px;

  color: rgba(243, 241, 234, 0.38);

  text-transform: uppercase;
}

.voyage-cover-title h1 {
  margin: 0;

  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(56px, 9vw, 110px);
  font-weight: 500;
  line-height: 0.86;
  letter-spacing: -0.055em;

  color: var(--vl-paper);
}

.voyage-cover-title h1 span {
  display: block;

  margin-left: 0.18em;

  color: var(--vl-gold);
  font-weight: 400;
}

.voyage-cover-subtitle {
  margin-top: 22px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 2px;
  line-height: 1.7;

  color: rgba(243, 241, 234, 0.45);

  text-transform: uppercase;
}

.voyage-cover-route {
  position: relative;

  width: 280px;
  padding-bottom: 8px;
}

.voyage-cover-route::before {
  content: "";

  position: absolute;
  left: 0;
  right: 0;
  bottom: 27px;

  height: 1px;

  background:
    repeating-linear-gradient(
      90deg,
      rgba(243, 241, 234, 0.35) 0 5px,
      transparent 5px 10px
    );
}

.voyage-cover-route::after {
  content: "GDN                                      STP";

  position: absolute;
  left: 0;
  right: 0;
  bottom: 4px;

  white-space: pre;

  font-family: "IBM Plex Mono", monospace;
  font-size: 6px;
  letter-spacing: 0.7px;

  color: rgba(243, 241, 234, 0.35);
}

.voyage-seal {
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  width: 92px;
  height: 92px;

  border: 1px solid rgba(168, 148, 104, 0.55);
  border-radius: 50%;

  outline: 1px solid rgba(168, 148, 104, 0.20);
  outline-offset: -7px;

  transform: rotate(-8deg);

  color: var(--vl-gold);
}

.voyage-seal::before,
.voyage-seal::after {
  content: "✦";

  position: absolute;

  font-size: 7px;
}

.voyage-seal::before {
  top: 13px;
}

.voyage-seal::after {
  bottom: 13px;
}

.voyage-seal span {
  font-family: "Fraunces", Georgia, serif;
  font-size: 28px;
  line-height: 1;
}

.voyage-seal small {
  margin-top: 6px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 6px;
  letter-spacing: 1.8px;
}

.voyage-cover-info {
  position: relative;
  z-index: 2;

  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 11px;

  margin-top: 55px;
  padding-top: 15px;

  border-top: 1px solid rgba(243, 241, 234, 0.10);

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: 1.5px;

  color: rgba(243, 241, 234, 0.48);

  text-transform: uppercase;
}

.voyage-cover-info i {
  width: 3px;
  height: 3px;

  border-radius: 50%;

  background: var(--vl-gold);
}


/* =========================================================
   CHAPITRES
   ========================================================= */

.voyage-tabs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);

  background: #0d1217;
}

.voyage-tab {
  position: relative;

  display: flex;
  align-items: flex-start;

  min-height: 92px;

  padding: 20px 20px 18px;

  border: 0;
  border-right: 1px solid rgba(243, 241, 234, 0.08);

  background: transparent;

  color: rgba(243, 241, 234, 0.42);

  text-align: left;

  cursor: pointer;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.voyage-tab:first-child {
  border-left: 1px solid rgba(243, 241, 234, 0.08);
}

.voyage-tab::before {
  content: "";

  position: absolute;
  top: 0;
  left: 0;

  width: 3px;
  height: 100%;

  background: transparent;

  transition: background 0.2s ease;
}

.voyage-tab::after {
  content: "";

  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 0;

  height: 1px;

  background: transparent;

  transition: background 0.2s ease;
}

.voyage-tab-number {
  flex: 0 0 auto;

  margin-right: 13px;
  padding-top: 2px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 1px;

  color: rgba(168, 148, 104, 0.70);
}

.voyage-tab-content {
  display: flex;
  flex-direction: column;
  gap: 7px;

  min-width: 0;
}

.voyage-tab-label {
  display: flex;
  align-items: center;
  gap: 6px;

  font-family: "Fraunces", Georgia, serif;
  font-size: 18px;
  font-weight: 600;
  line-height: 1;

  color: inherit;
}

.voyage-tab-subtitle {
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  line-height: 1.3;
  letter-spacing: 1.3px;

  color: rgba(243, 241, 234, 0.27);

  white-space: nowrap;
}

.voyage-tab:hover:not(.active) {
  background: rgba(243, 241, 234, 0.025);
  color: rgba(243, 241, 234, 0.75);
}

.voyage-tab.active {
  background: rgba(243, 241, 234, 0.045);
  color: var(--vl-paper);
}

.voyage-tab.active::before {
  background: var(--vl-red);
}

.voyage-tab.active::after {
  background: var(--vl-red);
}

.voyage-tab.active .voyage-tab-subtitle {
  color: rgba(243, 241, 234, 0.46);
}


/* =========================================================
   CONTENU DES ONGLETS
   ========================================================= */

.voyage-tab-content {
  position: relative;
}


/* =========================================================
   TICKET PRINCIPAL
   ========================================================= */

.ticket-card {
  position: relative !important;

  display: flex !important;

  width: 100%;
  min-height: 315px;

  overflow: hidden !important;

  isolation: isolate;

  border: 1px solid rgba(16, 20, 25, 0.19) !important;
  border-radius: 3px !important;

  background:
    radial-gradient(
      ellipse at 12% 18%,
      rgba(168, 148, 104, 0.085),
      transparent 28%
    ),
    radial-gradient(
      ellipse at 88% 75%,
      rgba(78, 85, 93, 0.065),
      transparent 32%
    ),
    linear-gradient(
      115deg,
      rgba(255, 255, 255, 0.58),
      transparent 32%
    ),
    repeating-linear-gradient(
      0deg,
      rgba(16, 20, 25, 0.014) 0,
      rgba(16, 20, 25, 0.014) 1px,
      transparent 1px,
      transparent 5px
    ),
    var(--vl-paper) !important;

  box-shadow: var(--vl-shadow) !important;
}


/* =========================================================
   CADRE INTÉRIEUR
   ========================================================= */

.ticket-inner-border {
  position: absolute;

  inset: 10px;

  z-index: 1;

  border: 1px solid rgba(16, 20, 25, 0.09);

  pointer-events: none;
}

.ticket-inner-border::before {
  content: "";

  position: absolute;

  inset: 5px;

  border: 1px solid rgba(168, 148, 104, 0.08);
}


/* =========================================================
   MICRO-GRAVURE DU BILLET
   ========================================================= */

.ticket-card::before {
  content: "";

  position: absolute;

  inset: 0;

  z-index: 0;

  pointer-events: none;

  background:
    repeating-radial-gradient(
      ellipse at 70% 40%,
      transparent 0,
      transparent 18px,
      rgba(16, 20, 25, 0.012) 18.5px,
      transparent 19.5px
    ),
    repeating-linear-gradient(
      135deg,
      transparent 0,
      transparent 17px,
      rgba(16, 20, 25, 0.010) 17px,
      rgba(16, 20, 25, 0.010) 18px
    );

  opacity: 0.75;
}

.ticket-card::after {
  content:
    "VOYAGE LONDRES · PARIS · LONDON · EUROSTAR 9020 · 13 MARS 2028 · PARIS · LONDON · VOYAGE LONDRES";

  position: absolute;

  left: 30px;
  right: 30px;
  bottom: 11px;

  z-index: 1;

  overflow: hidden;

  white-space: nowrap;

  text-align: center;

  font-family: "IBM Plex Mono", monospace;
  font-size: 5px;
  letter-spacing: 2.7px;

  color: rgba(16, 20, 25, 0.045);

  pointer-events: none;
}


/* =========================================================
   GRAVURE ARCHITECTURALE
   ========================================================= */

.ticket-engraving {
  position: absolute;

  right: 150px;
  bottom: -105px;

  width: 350px;
  height: 350px;

  z-index: 0;

  pointer-events: none;

  opacity: 0.22;
}

.ticket-engraving-circle {
  position: absolute;

  border: 1px solid rgba(16, 20, 25, 0.16);

  border-radius: 50%;
}

.ticket-engraving-circle-a {
  inset: 10px;
}

.ticket-engraving-circle-b {
  inset: 42px;
}

.ticket-engraving-lines {
  position: absolute;

  inset: 75px;

  border-radius: 50%;

  background:
    repeating-radial-gradient(
      circle,
      transparent 0,
      transparent 7px,
      rgba(16, 20, 25, 0.10) 8px,
      transparent 9px
    );
}

.ticket-engraving-arch {
  position: absolute;

  font-family: "IBM Plex Mono", monospace;
  font-weight: 500;

  letter-spacing: 7px;

  color: rgba(16, 20, 25, 0.075);

  transform: rotate(-12deg);
}

.ticket-engraving-arch-paris {
  top: 105px;
  left: 48px;

  font-size: 43px;
}

.ticket-engraving-arch-london {
  top: 157px;
  left: 82px;

  font-size: 30px;
}


/* =========================================================
   CORPS PRINCIPAL
   ========================================================= */

.ticket-main {
  position: relative;

  z-index: 3;

  flex: 1 1 auto;

  min-width: 0;

  padding: 30px 34px 27px;
}


/* =========================================================
   EN-TÊTE
   ========================================================= */

.ticket-header-premium {
  position: relative;
}

.ticket-header-top {
  display: flex;

  align-items: center;
  justify-content: space-between;

  gap: 20px;

  margin: 0 0 11px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;

  letter-spacing: 2.2px;

  color: rgba(16, 20, 25, 0.55);

  text-transform: uppercase;
}

.ticket-header-top span:last-child {
  color: var(--vl-red);
}

.ticket-security-line {
  display: flex;

  gap: 3px;

  height: 2px;

  margin: 0 0 20px;

  overflow: hidden;
}

.ticket-security-line span {
  flex: 1;

  height: 1px;

  margin-top: 1px;

  background: rgba(16, 20, 25, 0.16);
}

.ticket-security-line span:nth-child(4n) {
  background: rgba(167, 25, 48, 0.55);
}

.ticket-title-row {
  display: flex;

  align-items: flex-start;
  justify-content: space-between;

  gap: 20px;
}

.ticket-card h3 {
  margin: 0 !important;

  font-family: "Fraunces", Georgia, serif !important;

  font-size: clamp(23px, 3vw, 31px) !important;

  font-weight: 600 !important;

  line-height: 1.04 !important;

  letter-spacing: -0.025em !important;

  color: var(--vl-ink) !important;
}

.ticket-location {
  display: flex;

  align-items: center;

  gap: 6px;

  margin-top: 8px;

  font-family: "IBM Plex Mono", monospace;

  font-size: 8px;

  line-height: 1.4;

  letter-spacing: 1.1px;

  color: rgba(78, 85, 93, 0.72);

  text-transform: uppercase;
}

.ticket-proposal {
  flex: 0 0 auto;

  padding: 6px 9px;

  border: 1px solid rgba(167, 25, 48, 0.40);

  font-family: "IBM Plex Mono", monospace;

  font-size: 6px;

  letter-spacing: 1.5px;

  color: var(--vl-red);

  text-transform: uppercase;
}


/* =========================================================
   ROUTE PARIS → LONDON
   ========================================================= */

.ticket-route-graphic {
  position: relative;

  z-index: 3;

  margin-top: 25px;

  padding: 16px 0 13px;

  border-top: 1px solid var(--vl-line-soft);
  border-bottom: 1px solid var(--vl-line-soft);
}

.ticket-route-label {
  display: grid;

  grid-template-columns: minmax(50px, 0.8fr) minmax(150px, 2.4fr) minmax(50px, 0.8fr);

  align-items: center;

  gap: 12px;

  font-family: "IBM Plex Mono", monospace;

  font-size: 10px;

  font-weight: 500;

  letter-spacing: 2.7px;

  color: var(--vl-ink);
}

.ticket-route-label > span:first-child {
  text-align: left;
}

.ticket-route-label > span:last-child {
  text-align: right;
}

.ticket-route-center {
  display: flex;

  align-items: center;

  gap: 8px;

  min-width: 0;

  font-family: "IBM Plex Mono", monospace;

  font-size: 6px;

  letter-spacing: 0.9px;

  color: rgba(78, 85, 93, 0.65);

  white-space: nowrap;
}

.ticket-route-line {
  display: flex;

  align-items: center;

  flex: 1;

  min-width: 40px;

  gap: 4px;
}

.ticket-route-line::before,
.ticket-route-line::after {
  content: "";

  height: 1px;

  flex: 1;

  background:
    repeating-linear-gradient(
      90deg,
      rgba(16, 20, 25, 0.36) 0 5px,
      transparent 5px 9px
    );
}

.ticket-route-line b {
  width: 8px;
  height: 8px;

  flex: 0 0 8px;

  border: 1px solid var(--vl-red);

  border-radius: 50%;

  background: var(--vl-red);
}

.ticket-route-line i {
  display: none;
}

.ticket-route-date {
  margin-top: 9px;

  text-align: center;

  font-family: "IBM Plex Mono", monospace;

  font-size: 6px;

  letter-spacing: 2px;

  color: rgba(78, 85, 93, 0.55);

  text-transform: uppercase;
}


/* =========================================================
   SCEAU PARIS × LONDON
   ========================================================= */

.ticket-stamp {
  position: absolute;

  top: 119px;
  right: 38px;

  z-index: 4;

  display: flex;

  flex-direction: column;

  align-items: center;

  justify-content: center;

  width: 86px;
  height: 86px;

  border: 1px solid rgba(167, 25, 48, 0.52);

  border-radius: 50%;

  outline: 1px solid rgba(167, 25, 48, 0.23);

  outline-offset: -7px;

  transform: rotate(-11deg);

  background: rgba(243, 241, 234, 0.34);

  color: rgba(167, 25, 48, 0.73);

  font-family: "IBM Plex Mono", monospace;

  pointer-events: none;
}

.ticket-stamp::before,
.ticket-stamp::after {
  content: "✦";

  position: absolute;

  font-size: 8px;
}

.ticket-stamp::before {
  top: 12px;
}

.ticket-stamp::after {
  bottom: 12px;
}

.ticket-stamp span {
  font-size: 6px;
  letter-spacing: 1.5px;
}

.ticket-stamp strong {
  margin: 1px 0;

  font-family: Georgia, serif;

  font-size: 17px;

  font-weight: 400;
}

.ticket-stamp small {
  font-size: 6px;

  letter-spacing: 2px;
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.ticket-description {
  position: relative;

  z-index: 3;

  max-width: 65ch;

  margin-top: 18px;
}

.ticket-description p {
  margin: 0 !important;

  font-size: 13px !important;

  line-height: 1.58 !important;

  color: rgba(16, 20, 25, 0.76) !important;
}

.ticket-read-more {
  display: flex;

  align-items: center;

  gap: 4px;

  margin-top: 8px;

  padding: 0;

  border: 0;

  background: transparent;

  font-family: "IBM Plex Mono", monospace;

  font-size: 7px;

  letter-spacing: 1px;

  color: var(--vl-gold);

  cursor: pointer;
}


/* =========================================================
   META
   ========================================================= */

.ticket-meta {
  position: relative;

  z-index: 3;

  display: flex;

  flex-direction: column;

  gap: 5px;

  margin-top: 15px;
}

.ticket-meta div {
  display: flex;

  gap: 8px;

  align-items: baseline;

  font-size: 11px;
}

.ticket-meta span {
  flex: 0 0 auto;

  font-family: "IBM Plex Mono", monospace;

  font-size: 7px;

  letter-spacing: 0.9px;

  color: var(--vl-gold);

  text-transform: uppercase;
}

.ticket-meta strong {
  font-weight: 400;

  color: rgba(16, 20, 25, 0.74);
}


/* =========================================================
   PROPOSITION / AUTEUR
   ========================================================= */

.ticket-author {
  position: relative;

  z-index: 3;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 12px;

  margin-top: 16px;

  padding-top: 11px;

  border-top: 1px dashed rgba(16, 20, 25, 0.14);

  font-family: "IBM Plex Mono", monospace;

  font-size: 7px;

  color: rgba(16, 20, 25, 0.55);
}

.ticket-author button {
  padding: 0;

  border: 0;

  background: transparent;

  font-family: "IBM Plex Mono", monospace;

  font-size: 7px;

  color: var(--vl-red);

  cursor: pointer;
}

.ticket-delete-confirm {
  display: flex;

  align-items: center;

  gap: 8px;
}

.ticket-delete-confirm span {
  color: var(--vl-red);
}


/* =========================================================
   PERFORATION CENTRALE
   ========================================================= */

.ticket-perforation {
  position: relative;

  z-index: 5;

  width: 1px;

  flex: 0 0 1px;

  margin: 22px 0;

  background:
    repeating-linear-gradient(
      to bottom,
      rgba(16, 20, 25, 0.33) 0 4px,
      transparent 4px 9px
    );
}

.ticket-perforation > span {
  position: absolute;

  left: 50%;

  width: 17px;
  height: 17px;

  margin-left: -8px;

  border-radius: 50%;

  background: var(--vl-paper);

  box-shadow:
    0 0 0 1px rgba(16, 20, 25, 0.13),
    0 0 0 3px rgba(243, 241, 234, 0.80);
}

.ticket-perforation > span:first-child {
  top: -9px;
}

.ticket-perforation > span:last-child {
  bottom: -9px;
}


/* =========================================================
   COUPON YOUR CHOICE
   ========================================================= */

.ticket-choice {
  position: relative;

  z-index: 3;

  display: flex;

  flex: 0 0 215px;

  flex-direction: column;

  align-items: center;

  width: 215px;

  min-width: 215px;

  padding: 30px 20px 22px;

  overflow: hidden;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.45),
      transparent 45%
    ),
    radial-gradient(
      circle at 20% 20%,
      rgba(168, 148, 104, 0.08),
      transparent 35%
    ),
    var(--vl-paper-dark) !important;

  border-left: 1px solid rgba(16, 20, 25, 0.08);
}

.ticket-choice::before {
  content: "";

  position: absolute;

  inset: 10px;

  border: 1px solid rgba(16, 20, 25, 0.055);

  pointer-events: none;
}

.ticket-choice::after {
  content: "VL · 2028";

  position: absolute;

  right: 17px;
  bottom: 11px;

  font-family: "IBM Plex Mono", monospace;

  font-size: 5px;

  letter-spacing: 1.7px;

  color: rgba(16, 20, 25, 0.24);
}

.ticket-choice-watermark {
  position: absolute;

  right: -20px;
  bottom: -33px;

  font-family: "Fraunces", Georgia, serif;

  font-size: 118px;

  font-weight: 600;

  line-height: 1;

  color: rgba(16, 20, 25, 0.035);

  transform: rotate(-11deg);

  pointer-events: none;
}

.ticket-choice-label {
  position: relative;

  z-index: 2;

  font-family: "IBM Plex Mono", monospace;

  font-size: 7px;

  letter-spacing: 3px;

  color: rgba(78, 85, 93, 0.70);

  text-transform: uppercase;
}

.ticket-price {
  position: relative;

  z-index: 2;

  margin-top: 19px;

  text-align: center;
}

.ticket-price strong {
  display: block;

  font-family: "Fraunces", Georgia, serif;

  font-size: 26px;

  font-weight: 600;

  line-height: 1;

  color: var(--vl-ink);
}

.ticket-price span {
  display: block;

  margin-top: 4px;

  font-family: "IBM Plex Mono", monospace;

  font-size: 6px;

  letter-spacing: 1.5px;

  color: rgba(78, 85, 93, 0.63);

  text-transform: uppercase;
}


/* =========================================================
   VOTES
   ========================================================= */

.ticket-votes {
  position: relative;

  z-index: 3;

  display: flex;

  align-items: center;

  gap: 7px;

  margin-top: 18px;
}

.ticket-card .vote-button {
  position: relative;

  width: 68px !important;
  height: 35px !important;

  padding: 0 !important;

  border: 1px solid rgba(16, 20, 25, 0.19) !important;

  border-radius: 2px !important;

  background: rgba(243, 241, 234, 0.72) !important;

  color: var(--vl-ink) !important;

  font-family: "IBM Plex Mono", monospace !important;

  font-size: 8px !important;

  font-weight: 500 !important;

  letter-spacing: 1.1px !important;

  text-transform: uppercase;

  cursor: pointer;

  box-shadow: none !important;

  transition:
    transform 0.16s ease,
    border-color 0.16s ease,
    background 0.16s ease,
    color 0.16s ease;
}

.ticket-card .vote-button:hover:not(:disabled) {
  transform: translateY(-1px);

  border-color: rgba(16, 20, 25, 0.40) !important;

  background: rgba(250, 249, 245, 0.95) !important;
}

.ticket-card .vote-button.active {
  color: var(--vl-paper) !important;
}

.ticket-card .vote-button.active.vote-oui {
  background: var(--vl-red) !important;

  border-color: var(--vl-red) !important;

  box-shadow:
    0 5px 14px rgba(167, 25, 48, 0.18) !important;
}

.ticket-card .vote-button.active.vote-non {
  background: var(--vl-graphite) !important;

  border-color: var(--vl-graphite) !important;
}

.ticket-card .vote-button:disabled {
  cursor: not-allowed;

  opacity: 0.42 !important;
}


/* =========================================================
   VOTE ICONS / LABELS
   ========================================================= */

.vote-icon {
  display: inline-flex;

  align-items: center;
  justify-content: center;

  margin-right: 4px;
}

.vote-label {
  display: inline-block;
}


/* =========================================================
   VOTANTS
   ========================================================= */

.ticket-voters {
  position: relative;

  z-index: 3;

  width: 100%;

  margin-top: 18px;

  text-align: center;

  font-family: "IBM Plex Mono", monospace;

  font-size: 6.5px;

  line-height: 1.6;

  color: rgba(78, 85, 93, 0.66);
}

.ticket-voters div {
  display: flex;

  flex-direction: column;

  margin-bottom: 5px;
}

.ticket-voters b {
  font-size: 6.5px;

  font-weight: 500;

  letter-spacing: 1px;

  color: var(--vl-ink);
}

.ticket-voters span {
  overflow-wrap: anywhere;
}


/* =========================================================
   COUPON CODE
   ========================================================= */

.ticket-coupon-code {
  position: absolute;

  bottom: 12px;

  font-family: "IBM Plex Mono", monospace;

  font-size: 5px;

  letter-spacing: 2px;

  color: rgba(16, 20, 25, 0.25);
}


