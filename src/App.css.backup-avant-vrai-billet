/* =========================================================
   VOYAGE LONDRES
   PREMIUM TRAVEL DOSSIER
   APP.CSS — CLEAN EDITION
   ========================================================= */

/* =========================================================
   VARIABLES
   ========================================================= */

:root {
  --vl-paper: #f3f1ea;
  --vl-paper-light: #faf9f5;
  --vl-paper-dark: #e7e5de;

  --vl-ink: #101419;
  --vl-graphite: #4e555d;
  --vl-grey: #7a8087;

  --vl-silver: #c9ccd0;
  --vl-silver-dark: #aeb3b8;

  --vl-red: #a71930;
  --vl-red-dark: #861327;

  --vl-gold: #a89468;

  --vl-line: rgba(16, 20, 25, 0.13);
  --vl-line-soft: rgba(16, 20, 25, 0.07);

  --vl-shadow:
    0 22px 50px rgba(16, 20, 25, 0.12),
    5px 6px 0 rgba(16, 20, 25, 0.035);
}


