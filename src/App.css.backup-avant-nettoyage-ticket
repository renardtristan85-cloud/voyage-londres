/* =========================================================
   VOYAGE COVER
   ========================================================= */

.voyage-cover {
  position: relative;
  min-height: 680px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(255, 255, 255, 0.07),
      transparent 25%
    ),
    radial-gradient(
      circle at 80% 70%,
      rgba(167, 25, 48, 0.12),
      transparent 30%
    ),
    #11151a;
  color: #f4f1e9;
  isolation: isolate;
}

.voyage-cover::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.22;
  pointer-events: none;
  background-image:
    linear-gradient(
      115deg,
      transparent 0 48%,
      rgba(255,255,255,.08) 49%,
      transparent 50%
    ),
    linear-gradient(
      25deg,
      transparent 0 48%,
      rgba(255,255,255,.035) 49%,
      transparent 50%
    );
  background-size: 90px 90px, 130px 130px;
}

.voyage-cover::after {
  content: "PARIS  ·  LONDON  ·  PARIS  ·  LONDON  ·  EUROSTAR  ·  2028";
  position: absolute;
  left: -20%;
  right: -20%;
  bottom: 58px;
  transform: rotate(-4deg);
  color: rgba(255,255,255,.025);
  font-family: "IBM Plex Mono", monospace;
  font-size: 70px;
  letter-spacing: .08em;
  white-space: nowrap;
  pointer-events: none;
}

.voyage-cover-top,
.voyage-cover-main,
.voyage-cover-info {
  position: relative;
  z-index: 2;
}

.voyage-cover-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px clamp(24px, 6vw, 90px);
  border-bottom: 1px solid rgba(255,255,255,.12);
}

.voyage-cover-eyebrow {
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: rgba(255,255,255,.58);
}

.voyage-cover-main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 100px 28px 70px;
}

.voyage-cover-title {
  margin: 0;
  max-width: 850px;
  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(70px, 13vw, 180px);
  font-weight: 500;
  line-height: .78;
  letter-spacing: -.075em;
}

.voyage-cover-subtitle {
  margin-top: 30px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(255,255,255,.64);
}

.voyage-cover-route {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 54px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: .12em;
}

.voyage-cover-route::before {
  content: "";
  width: 70px;
  height: 1px;
  background: var(--vl-red);
}

.voyage-cover-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
  padding: 0 clamp(24px, 6vw, 90px) 45px;
}

.voyage-kicker {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.voyage-kicker-number {
  color: var(--vl-red);
}

.voyage-seal {
  width: 108px;
  height: 108px;
  border: 1px solid rgba(255,255,255,.34);
  border-radius: 50%;
  display: grid;
  place-items: center;
  position: relative;
  transform: rotate(-8deg);
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: .13em;
  text-align: center;
}

.voyage-seal::before,
.voyage-seal::after {
  content: "";
  position: absolute;
  border-radius: 50%;
}

.voyage-seal::before {
  inset: 7px;
  border: 1px dashed rgba(255,255,255,.3);
}

.voyage-seal::after {
  inset: 17px;
  border: 1px solid rgba(255,255,255,.15);
}


/* =========================================================
   TABS
   ========================================================= */

.voyage-tabs {
  display: flex;
  gap: 0;
  overflow-x: auto;
  background: #15191e;
  border-bottom: 1px solid rgba(255,255,255,.14) !important;
  scrollbar-width: none;
}

.voyage-tabs::-webkit-scrollbar {
  display: none;
}

.voyage-tab {
  position: relative;
  min-width: 190px;
  padding: 24px 24px 21px;
  color: rgba(255,255,255,.52);
  background: transparent;
  cursor: pointer;
  text-align: left;
  transition:
    color .25s ease,
    background .25s ease;
}

.voyage-tab::after {
  content: "";
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 0;
  height: 3px;
  background: var(--vl-red);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .25s ease;
}

.voyage-tab:hover {
  color: white;
  background: rgba(255,255,255,.035);
}

.voyage-tab.active {
  color: white;
  background: rgba(255,255,255,.045);
}

.voyage-tab.active::after {
  transform: scaleX(1);
}

.voyage-tab-number {
  display: block;
  margin-bottom: 8px;
  color: var(--vl-red);
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: .14em;
}

.voyage-tab-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.voyage-tab-label {
  font-family: "Fraunces", Georgia, serif;
  font-size: 20px;
  font-weight: 500;
}

.voyage-tab-subtitle {
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(255,255,255,.36);
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.voyage-tab-content {
  min-width: 0;
}

.ticket-category-hebergement,
.ticket-category-repas,
