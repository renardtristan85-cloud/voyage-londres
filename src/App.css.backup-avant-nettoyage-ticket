/* =========================================================
   SCROLLBARS
   ========================================================= */

* {
  scrollbar-width: thin;
  scrollbar-color: rgba(255,255,255,.22) transparent;
}

::-webkit-scrollbar {
  width: 7px;
  height: 7px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: rgba(255,255,255,.18);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255,255,255,.32);
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    transition-duration: .01ms !important;
    animation-duration: .01ms !important;
  }
}




/* =========================================================
   TICKET — FINAL GRAPHIC SYSTEM
   ========================================================= */

.ticket-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 190px;
  width: min(100%, 1040px);
  min-height: 390px;
  margin: 0 auto 34px;
  overflow: hidden;
  isolation: isolate;

  color: #101419;

  background:
    radial-gradient(
      circle at 18% 20%,
      rgba(255,255,255,.95),
      transparent 30%
    ),
    radial-gradient(
      circle at 80% 75%,
      rgba(170,175,180,.13),
      transparent 35%
    ),
    #f3f1ea;

  border: 1px solid rgba(70,76,82,.22);
  border-radius: 6px;

  box-shadow:
    0 22px 45px rgba(10,14,18,.14),
    0 3px 0 rgba(255,255,255,.8) inset;
}

/* Papier */
.ticket-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;

  opacity: .28;

  background-image:
    radial-gradient(
      rgba(30,35,40,.34) .45px,
      transparent .55px
    ),
    radial-gradient(
      rgba(255,255,255,.8) .45px,
      transparent .55px
    );

  background-size: 5px 5px, 7px 7px;
  background-position: 0 0, 2px 3px;

  mix-blend-mode: multiply;
}

/* Bordure extérieure */
.ticket-card::after {
  content: "";
  position: absolute;
  inset: 9px;
  z-index: 4;
  pointer-events: none;

  border: 1px solid rgba(72,78,84,.20);
  border-radius: 3px;
}

/* =========================================================
   GRAPHISME SVG
   ========================================================= */

.ticket-engraving {
  position: absolute !important;
  inset: 0 !important;

  width: 100% !important;
  height: 100% !important;

  z-index: 1 !important;

  margin: 0 !important;
  overflow: hidden !important;

  opacity: 1 !important;
  transform: none !important;

  pointer-events: none !important;
}

.ticket-security-art {
  position: absolute !important;
  inset: 0 !important;

  width: 100% !important;
  height: 100% !important;

  display: block !important;
}

/* Guilloché */
.ticket-guilloche path {
  fill: none;
  stroke: rgba(105,112,120,.18);
  stroke-width: 1;
}

/* Cercles de sécurité */
.ticket-security-circles circle {
  fill: none;
  stroke: rgba(105,112,120,.22);
  stroke-width: 1;
}

/* Architecture */
.ticket-monument {
  fill: none;
  stroke: rgba(88,96,104,.28);
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.ticket-paris,
.ticket-london {
  opacity: .95;
}

/* London Eye */
.ticket-eye {
  fill: none;
  stroke: rgba(88,96,104,.22);
  stroke-width: 1;
}

/* Arcs */
.ticket-arc {
  stroke: rgba(110,117,124,.16);
  stroke-width: 1;
}

/* Microtexte */
.ticket-microtext {
  fill: rgba(75,83,91,.25);

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 3px;
}

/* Filigrane */
.ticket-watermark-title {
  fill: rgba(75,83,91,.075);

  font-family: "Fraunces", serif;
  font-size: 34px;
  font-weight: 600;
  letter-spacing: 8px;
}

.ticket-watermark-year {
  fill: rgba(75,83,91,.12);

  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: 8px;
}

/* =========================================================
   BORDURE INTERNE
   ========================================================= */

.ticket-inner-border {
  position: absolute;
  inset: 17px;

  z-index: 6;

  pointer-events: none;

  border: 1px solid rgba(65,72,79,.18);
  border-radius: 2px;
}

.ticket-inner-border::before {
  content: "";

  position: absolute;
  inset: 4px;

  border: 1px dashed rgba(95,102,109,.13);
}

/* =========================================================
   CONTENU PRINCIPAL
   ========================================================= */

.ticket-main {
  position: relative;
  z-index: 10;

  min-width: 0;

  padding: 34px 38px 32px;
}

/* Header */
.ticket-header-premium {
  position: relative;
}

.ticket-header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;

  margin-bottom: 9px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  font-weight: 600;

  letter-spacing: 2px;
  text-transform: uppercase;

  color: #4e555d;
}

.ticket-document-number {
  opacity: .65;
}

.ticket-security-line {
  display: flex;
  align-items: center;
  gap: 3px;

  height: 5px;
  margin-bottom: 22px;
}

.ticket-security-line span {
  display: block;
  height: 2px;
  flex: 1;

  background: rgba(70,77,84,.22);
}

.ticket-security-line span:nth-child(2n) {
  flex: .35;
}

.ticket-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;
}

.ticket-title-row h3 {
  margin: 5px 0 5px;

  font-family: "Fraunces", serif;
  font-size: clamp(25px, 3vw, 38px);
  line-height: .98;
  font-weight: 600;
  letter-spacing: -.7px;

  color: #101419;
}

.ticket-kicker {
  display: block;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 600;

  letter-spacing: 2px;
  text-transform: uppercase;

  color: #a71930;
}

.ticket-location {
  display: flex;
  align-items: center;
  gap: 5px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: 1px;

  color: #697078;
}

.ticket-proposal {
  flex: 0 0 auto;

  padding: 6px 8px;

  border: 1px solid rgba(167,25,48,.35);

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 700;

  letter-spacing: 1.5px;

  color: #a71930;
}

/* =========================================================
   ROUTE
   ========================================================= */

.ticket-route-graphic {
  position: relative;

  margin: 30px 0 23px;
  padding: 18px 0 15px;

  border-top: 1px solid rgba(65,72,79,.17);
  border-bottom: 1px solid rgba(65,72,79,.17);
}

.ticket-route-label {
  display: grid;
  grid-template-columns: 105px minmax(100px, 1fr) 105px;
  align-items: center;
  gap: 18px;
}

.ticket-city {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.ticket-city:last-child {
  align-items: flex-end;
  text-align: right;
}

.ticket-city strong {
  font-family: "Fraunces", serif;
  font-size: 19px;
  letter-spacing: 1px;
}

.ticket-city span {
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 1.5px;
  color: #697078;
}

.ticket-route-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: 1.5px;
  color: #697078;
}

.ticket-route-line {
  display: flex;
  align-items: center;

  width: 100%;
  height: 12px;
}

.ticket-route-line i {
  width: 7px;
  height: 7px;

  border: 1px solid #697078;
  border-radius: 50%;

  background: #f3f1ea;
}

.ticket-route-line b {
  flex: 1;
  height: 1px;

  background:
    repeating-linear-gradient(
      90deg,
      #697078 0 7px,
      transparent 7px 12px
    );
}

.ticket-route-date {
  margin-top: 9px;

  text-align: center;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 600;

  letter-spacing: 2px;

  color: #4e555d;
}

/* =========================================================
   SCEAU
   ========================================================= */

.ticket-stamp {
  position: absolute;

  top: 235px;
  right: 225px;

  width: 82px;
  height: 82px;

  z-index: 8;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4px;

  border: 1px solid rgba(167,25,48,.45);
  border-radius: 50%;

  transform: rotate(-11deg);

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 700;

  letter-spacing: 1px;

  color: rgba(167,25,48,.72);

  background: rgba(243,241,234,.32);
}

.ticket-stamp::before {
  content: "";

  position: absolute;
  inset: 5px;

  border: 1px dashed rgba(167,25,48,.35);
  border-radius: 50%;
}

.ticket-stamp strong {
  font-size: 11px;
}

.ticket-stamp small {
  position: absolute;
  bottom: 17px;

  font-size: 6px;
  letter-spacing: 2px;
}

/* =========================================================
   DESCRIPTION
   ========================================================= */

.ticket-description {
  max-width: 620px;

  margin-top: 5px;
}

.ticket-description p {
  margin: 0;

  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  line-height: 1.7;

  color: #4e555d;
}

.ticket-read-more {
  display: inline-flex;
  align-items: center;
  gap: 4px;

  margin-top: 9px;
  padding: 0;

  border: 0;
  background: transparent;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 700;

  letter-spacing: 1px;
  text-transform: uppercase;

  color: #a71930;

  cursor: pointer;
}

/* =========================================================
   META
   ========================================================= */

.ticket-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 0;

  max-width: 680px;

  margin-top: 20px;

  border-top: 1px solid rgba(65,72,79,.14);
  border-bottom: 1px solid rgba(65,72,79,.14);
}

.ticket-meta > div {
  min-width: 110px;

  padding: 9px 15px 9px 0;
  margin-right: 15px;

  border-right: 1px solid rgba(65,72,79,.12);
}

.ticket-meta > div:last-child {
  border-right: 0;
}

.ticket-meta span,
.ticket-meta strong {
  display: block;
}

.ticket-meta span {
  margin-bottom: 3px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: 1px;
  text-transform: uppercase;

  color: #7a8087;
}

.ticket-meta strong {
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;

  color: #101419;
}

/* Proposition */
.ticket-author {
  display: flex;
  align-items: center;
  gap: 12px;

  margin-top: 13px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;

  color: #7a8087;
}

.ticket-author button {
  border: 0;
  background: transparent;

  font: inherit;
  color: #a71930;

  cursor: pointer;
}

.ticket-delete-confirm {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

.ticket-delete-confirm button {
  padding: 3px 6px;

  border: 1px solid rgba(70,77,84,.2);
}

/* =========================================================
   PERFORATION
   ========================================================= */

.ticket-perforation {
  position: absolute;

  top: 0;
  right: 190px;
  bottom: 0;

  width: 1px;

  z-index: 12;

  border-left: 2px dotted rgba(65,72,79,.24);

  pointer-events: none;
}

.ticket-perforation::before,
.ticket-perforation::after {
  content: "";

  position: absolute;

  left: -9px;

  width: 16px;
  height: 16px;

  border: 1px solid rgba(65,72,79,.18);
  border-radius: 50%;

  background: #101419;
}

.ticket-perforation::before {
  top: -8px;
}

.ticket-perforation::after {
  bottom: -8px;
}

.ticket-perforation > span {
  position: absolute;

  left: -5px;

  width: 9px;
  height: 9px;

  border: 1px solid rgba(65,72,79,.18);
  border-radius: 50%;

  background: #f3f1ea;
}

.ticket-perforation > span:first-child {
  top: 25%;
}

.ticket-perforation > span:last-child {
  top: 75%;
}

/* =========================================================
   COUPON
   ========================================================= */

.ticket-choice {
  position: relative;

  z-index: 10;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  min-width: 0;

  padding: 30px 22px;

  overflow: hidden;

  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.62),
      rgba(214,215,211,.62)
    );

  border-left: 0;
}

.ticket-choice::before {
  content: "";

  position: absolute;
  inset: 12px;

  border: 1px solid rgba(65,72,79,.12);

  pointer-events: none;
}

.ticket-choice-watermark {
  position: absolute;

  right: -15px;
  bottom: -20px;

  font-family: "Fraunces", serif;
  font-size: 145px;
  line-height: 1;

  font-weight: 600;

  color: rgba(80,87,94,.055);

  pointer-events: none;
}

.ticket-choice-label {
  position: relative;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 700;

  letter-spacing: 2.5px;

  color: #4e555d;
}

.ticket-choice-divider {
  width: 45px;
  height: 1px;

  margin: 13px 0 15px;

  background: rgba(65,72,79,.28);
}

.ticket-price {
  position: relative;

  display: flex;
  flex-direction: column;
  align-items: center;

  margin-bottom: 20px;
}

.ticket-price strong {
  font-family: "Fraunces", serif;
  font-size: 31px;
  line-height: 1;

  font-weight: 600;

  color: #101419;
}

.ticket-price span {
  margin-top: 5px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 6px;
  letter-spacing: 1.5px;

  color: #7a8087;
}

.ticket-votes {
  position: relative;

  display: flex;
  gap: 7px;
}

.vote-button {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 5px;

  min-width: 66px;
  padding: 8px 9px;

  border: 1px solid rgba(65,72,79,.22);
  border-radius: 2px;

  background: rgba(255,255,255,.35);

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 700;

  letter-spacing: .8px;

  transition:
    transform .15s ease,
    background .15s ease,
    border-color .15s ease;
}

.vote-button:not(:disabled):hover {
  transform: translateY(-1px);
}

.vote-button.active {
  border-color: #101419;
  background: #101419;
  color: #f3f1ea;
}

.vote-icon {
  font-size: 12px;
  line-height: 1;
}

.ticket-voters {
  position: relative;

  width: 100%;

  margin-top: 17px;
  padding-top: 12px;

  border-top: 1px solid rgba(65,72,79,.15);

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  line-height: 1.55;

  text-align: center;

  color: #697078;
}

.ticket-voters > div {
  margin-bottom: 7px;
}

.ticket-voters b,
.ticket-voters span {
  display: block;
}

.ticket-voters b {
  margin-bottom: 2px;

  font-size: 7px;
  letter-spacing: 1px;

  color: #4e555d;
}

.ticket-coupon-code {
  position: absolute;

  left: 50%;
  bottom: 20px;

  transform: translateX(-50%);

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 700;

  letter-spacing: 2px;

  color: #7a8087;
}

/* =========================================================
   CATEGORY VARIATIONS
   ========================================================= */

.ticket-category-hebergement .ticket-paris,
.ticket-category-hebergement .ticket-london {
  opacity: .72;
}

.ticket-category-repas .ticket-security-circles circle {
  stroke-dasharray: 4 7;
}

.ticket-category-activites .ticket-monument {
  opacity: 1;
}

.ticket-category-dossier .ticket-guilloche path {
  stroke: rgba(105,112,120,.13);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 820px) {

  .ticket-card {
    grid-template-columns: minmax(0, 1fr) 150px;
    min-height: 370px;
  }

  .ticket-perforation {
    right: 150px;
  }

  .ticket-main {
    padding: 29px 27px;
  }

  .ticket-header-top {
    font-size: 8px;
  }

  .ticket-route-label {
    grid-template-columns: 75px minmax(80px, 1fr) 75px;
    gap: 10px;
  }

  .ticket-stamp {
    right: 180px;
    top: 230px;
    width: 68px;
    height: 68px;
  }

}

@media (max-width: 620px) {

  .ticket-card {
    display: block;

    min-height: 0;

    margin-bottom: 24px;
  }

  .ticket-main {
    padding: 27px 22px 30px;
  }

  .ticket-choice {
    min-height: 215px;

    padding: 27px 20px;

    border-top: 2px dotted rgba(65,72,79,.24);
  }

  .ticket-perforation {
    display: none;
  }

  .ticket-title-row h3 {
    font-size: 28px;
  }

  .ticket-header-top {
    flex-wrap: wrap;
  }

  .ticket-document-number {
    display: none;
  }

  .ticket-route-label {
    grid-template-columns: 62px minmax(70px, 1fr) 62px;
    gap: 7px;
  }

  .ticket-city strong {
    font-size: 15px;
  }

  .ticket-route-center {
    font-size: 6px;
    letter-spacing: 1px;
  }

  .ticket-stamp {
    top: auto;
    right: 22px;
    bottom: 27px;

    width: 62px;
    height: 62px;
  }

  .ticket-description {
    padding-right: 75px;
  }

  .ticket-meta > div {
    min-width: 95px;
  }

  .ticket-choice-watermark {
    font-size: 110px;
  }

}
