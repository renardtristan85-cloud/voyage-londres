/* =========================================================
   VARIABLES
   ========================================================= */

:root {
  --vl-paper: #f2f0e9;
  --vl-paper-light: #fbfaf6;
  --vl-paper-dark: #deddd7;

  --vl-ink: #11151a;
  --vl-ink-soft: #242a30;
  --vl-graphite: #555c63;
  --vl-grey: #858b91;

  --vl-silver: #c8cbd0;
  --vl-silver-dark: #aeb3b8;
  --vl-silver-line: rgba(82, 88, 95, 0.22);

  --vl-red: #a71930;
  --vl-red-dark: #7f1225;
  --vl-red-soft: rgba(167, 25, 48, 0.10);

  --vl-gold: #a89468;

  --vl-line: rgba(17, 21, 26, 0.14);
  --vl-line-soft: rgba(17, 21, 26, 0.07);

  --vl-shadow:
    0 30px 70px rgba(0, 0, 0, 0.18),
    0 8px 20px rgba(0, 0, 0, 0.08);

  --vl-shadow-small:
    0 12px 30px rgba(0, 0, 0, 0.12);

  --vl-radius: 4px;
}


/* =========================================================
   BASE
   ========================================================= */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-width: 320px;
  background: #11151a;
  color: var(--vl-ink);
  font-family:
    "IBM Plex Sans",
    "Inter",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  border: 0;
}

button:focus-visible,
input:focus-visible,
textarea:focus-visible,
select:focus-visible {
  outline: 2px solid var(--vl-red);
  outline-offset: 3px;
}

img {
  max-width: 100%;
}

::selection {
  background: var(--vl-red);
  color: white;
}


