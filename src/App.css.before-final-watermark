/* =========================================================
   TAMPON VOYAGE
   ========================================================= */

.ticket-vote-panel {
  position: relative;
  isolation: isolate;
  overflow: hidden;
}

.ticket-vote-seal {
  position: absolute;

  width: 145px;
  height: 145px;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%)
    rotate(-11deg);

