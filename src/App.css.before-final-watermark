/* =========================================================
   VOYAGE COVER
   ========================================================= */

.voyage-cover {
  position: relative;
  min-height: 680px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(255, 255, 255, 0.07),
      transparent 25%
    ),
    radial-gradient(
      circle at 80% 70%,
      rgba(167, 25, 48, 0.12),
      transparent 30%
    ),
    #11151a;
  color: #f4f1e9;
  isolation: isolate;
}

.voyage-cover::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.22;
  pointer-events: none;
  background-image:
    linear-gradient(
      115deg,
      transparent 0 48%,
      rgba(255,255,255,.08) 49%,
      transparent 50%
    ),
    linear-gradient(
      25deg,
      transparent 0 48%,
      rgba(255,255,255,.035) 49%,
      transparent 50%
    );
  background-size: 90px 90px, 130px 130px;
}

.voyage-cover::after {
  content: "PARIS  ·  LONDON  ·  PARIS  ·  LONDON  ·  EUROSTAR  ·  2028";
  position: absolute;
  left: -20%;
  right: -20%;
  bottom: 58px;
  transform: rotate(-4deg);
  color: rgba(255,255,255,.025);
  font-family: "IBM Plex Mono", monospace;
  font-size: 70px;
  letter-spacing: .08em;
  white-space: nowrap;
  pointer-events: none;
}

.voyage-cover-top,
.voyage-cover-main,
.voyage-cover-info {
  position: relative;
  z-index: 2;
}

.voyage-cover-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px clamp(24px, 6vw, 90px);
  border-bottom: 1px solid rgba(255,255,255,.12);
}

.voyage-cover-eyebrow {
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: rgba(255,255,255,.58);
}

.voyage-cover-main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 100px 28px 70px;
}

.voyage-cover-title {
  margin: 0;
  max-width: 850px;
  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(70px, 13vw, 180px);
  font-weight: 500;
  line-height: .78;
  letter-spacing: -.075em;
}

.voyage-cover-subtitle {
  margin-top: 30px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(255,255,255,.64);
}

.voyage-cover-route {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 54px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: .12em;
}

.voyage-cover-route::before {
  content: "";
  width: 70px;
  height: 1px;
  background: var(--vl-red);
}

.voyage-cover-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
  padding: 0 clamp(24px, 6vw, 90px) 45px;
}

.voyage-kicker {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.voyage-kicker-number {
  color: var(--vl-red);
}

.voyage-seal {
  width: 108px;
  height: 108px;
  border: 1px solid rgba(255,255,255,.34);
  border-radius: 50%;
  display: grid;
  place-items: center;
  position: relative;
  transform: rotate(-8deg);
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: .13em;
  text-align: center;
}

.voyage-seal::before,
.voyage-seal::after {
  content: "";
  position: absolute;
  border-radius: 50%;
}

.voyage-seal::before {
  inset: 7px;
  border: 1px dashed rgba(255,255,255,.3);
}

.voyage-seal::after {
  inset: 17px;
  border: 1px solid rgba(255,255,255,.15);
}


/* =========================================================
   TABS
   ========================================================= */

.voyage-tabs {
  display: flex;
  gap: 0;
  overflow-x: auto;
  background: #15191e;
  border-bottom: 1px solid rgba(255,255,255,.14) !important;
  scrollbar-width: none;
}

.voyage-tabs::-webkit-scrollbar {
  display: none;
}

.voyage-tab {
  position: relative;
  min-width: 190px;
  padding: 24px 24px 21px;
  color: rgba(255,255,255,.52);
  background: transparent;
  cursor: pointer;
  text-align: left;
  transition:
    color .25s ease,
    background .25s ease;
}

.voyage-tab::after {
  content: "";
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 0;
  height: 3px;
  background: var(--vl-red);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .25s ease;
}

.voyage-tab:hover {
  color: white;
  background: rgba(255,255,255,.035);
}

.voyage-tab.active {
  color: white;
  background: rgba(255,255,255,.045);
}

.voyage-tab.active::after {
  transform: scaleX(1);
}

.voyage-tab-number {
  display: block;
  margin-bottom: 8px;
  color: var(--vl-red);
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: .14em;
}

.voyage-tab-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.voyage-tab-label {
  font-family: "Fraunces", Georgia, serif;
  font-size: 20px;
  font-weight: 500;
}

.voyage-tab-subtitle {
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(255,255,255,.36);
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.voyage-tab-content {
  min-width: 0;
}

.ticket-category-hebergement,
.ticket-category-repas,
.ticket-category-activites,
.ticket-category-dossier {
  --category-mark: rgba(167, 25, 48, .08);
}

main {
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(255,255,255,.035),
      transparent 35%
    ),
    #171b20;
}


/* =========================================================
   TICKET — OUTER SHELL
   ========================================================= */

.ticket-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 175px;
  width: min(100%, 1040px);
  min-height: 355px;
  margin: 0 auto 34px;
  overflow: hidden;
  color: var(--vl-ink);
  background:
    radial-gradient(
      ellipse at 15% 20%,
      rgba(255,255,255,.85),
      transparent 28%
    ),
    radial-gradient(
      ellipse at 85% 85%,
      rgba(0,0,0,.045),
      transparent 34%
    ),
    var(--vl-paper);
  border: 1px solid rgba(255,255,255,.72);
  border-radius: 7px;
  box-shadow: var(--vl-shadow);
  isolation: isolate;
}

/* paper grain */
.ticket-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: .20;
  background-image:
    radial-gradient(rgba(20,25,30,.45) .45px, transparent .55px),
    radial-gradient(rgba(255,255,255,.9) .4px, transparent .5px);
  background-size: 5px 5px, 7px 7px;
  background-position: 0 0, 2px 3px;
  mix-blend-mode: multiply;
}

/* security print */
.ticket-card::after {
  content: "";
  position: absolute;
  inset: 8px;
  z-index: 1;
  pointer-events: none;
  border: 1px solid rgba(80,86,92,.17);
  border-radius: 4px;
}


/* =========================================================
   INNER BORDER
   ========================================================= */

.ticket-inner-border {
  position: absolute;
  inset: 16px;
  z-index: 2;
  pointer-events: none;
  border: 1px solid rgba(87,93,99,.17);
  border-radius: 2px;
}

.ticket-inner-border::before {
  content: "";
  position: absolute;
  inset: 4px;
  border: 1px dashed rgba(120,125,130,.13);
}


/* =========================================================
   TICKET MAIN
   ========================================================= */

.ticket-main {
  position: relative;
  z-index: 3;
  min-width: 0;
  padding: 30px 38px 30px;
}


/* =========================================================
   TICKET HEADER
   ========================================================= */

.ticket-header-premium {
  position: relative;
}

.ticket-header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  padding-bottom: 13px;
  border-bottom: 1px solid rgba(40,45,50,.18);
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 600;
  letter-spacing: .20em;
  text-transform: uppercase;
  color: #626970;
}

.ticket-header-top span:last-child {
  color: var(--vl-red);
}

.ticket-security-line {
  display: flex;
  gap: 3px;
  height: 4px;
  margin: 7px 0 20px;
  overflow: hidden;
}

.ticket-security-line span {
  display: block;
  height: 1px;
  flex: 1;
  margin-top: 1px;
  background: rgba(75,81,87,.28);
  transform: skewX(-25deg);
}

.ticket-security-line span:nth-child(3n) {
  background: rgba(167,25,48,.34);
}

.ticket-title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20px;
}

.ticket-title-row h3 {
  position: relative;
  z-index: 2;
  max-width: 620px;
  margin: 0;
  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(27px, 4vw, 42px);
  font-weight: 500;
  line-height: .98;
  letter-spacing: -.035em;
}

.ticket-location {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 10px;
  color: #747a80;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .11em;
  text-transform: uppercase;
}

.ticket-proposal {
  flex-shrink: 0;
  padding: 7px 9px;
  border: 1px solid rgba(167,25,48,.45);
  color: var(--vl-red);
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: .14em;
}


/* =========================================================
   ROUTE — HORIZONTAL
   ========================================================= */

.ticket-route-graphic {
  position: relative;
  z-index: 3;
  margin: 32px 0 18px;
  padding: 18px 0 14px;
  border-top: 1px solid rgba(60,65,70,.12);
  border-bottom: 1px solid rgba(60,65,70,.12);
}

.ticket-route-label {
  display: grid;
  grid-template-columns: auto minmax(120px, 1fr) auto;
  align-items: center;
  gap: 18px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .16em;
}

.ticket-route-label > span {
  color: var(--vl-ink);
}

.ticket-route-label > span:first-child::before,
.ticket-route-label > span:last-child::after {
  content: "";
  display: inline-block;
  width: 5px;
  height: 5px;
  margin: 0 7px 2px 0;
  border-radius: 50%;
  background: var(--vl-red);
}

.ticket-route-label > span:last-child::after {
  margin: 0 0 2px 7px;
}

.ticket-route-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 7px;
  min-width: 0;
}

.ticket-route-center > span {
  color: #858b91;
  font-size: 7px;
  letter-spacing: .10em;
  text-align: center;
}

.ticket-route-line {
  display: flex;
  align-items: center;
  width: 100%;
  height: 12px;
}

.ticket-route-line::before {
  content: "";
  flex: 1;
  height: 1px;
  background:
    repeating-linear-gradient(
      90deg,
      #737a81 0 5px,
      transparent 5px 8px
    );
}

.ticket-route-line i {
  display: block;
  width: 7px;
  height: 7px;
  border: 1px solid #687077;
  border-radius: 50%;
  background: var(--vl-paper);
}

.ticket-route-line b {
  width: 22px;
  height: 1px;
  background: var(--vl-red);
}

.ticket-route-line::after {
  content: "";
  flex: 1;
  height: 1px;
  background:
    repeating-linear-gradient(
      90deg,
      #737a81 0 5px,
      transparent 5px 8px
    );
}

.ticket-route-date {
  margin-top: 13px;
  text-align: center;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 600;
  letter-spacing: .20em;
  color: #5c636a;
}


/* =========================================================
   GRAPHIC STAMP
   ========================================================= */

.ticket-stamp {
  position: absolute;
  top: 164px;
  right: 38px;
  z-index: 5;
  width: 108px;
  height: 108px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4px;
  border: 2px solid rgba(167,25,48,.42);
  border-radius: 50%;
  color: rgba(167,25,48,.68);
  transform: rotate(-13deg);
  opacity: .78;
  font-family: "IBM Plex Mono", monospace;
  font-weight: 700;
  letter-spacing: .04em;
  pointer-events: none;
}

.ticket-stamp::before {
  content: "";
  position: absolute;
  inset: 7px;
  border: 1px dashed rgba(167,25,48,.42);
  border-radius: 50%;
}

.ticket-stamp::after {
  content: "";
  position: absolute;
  inset: 14px;
  border: 1px solid rgba(167,25,48,.18);
  border-radius: 50%;
}

.ticket-stamp span {
  font-size: 9px;
}

.ticket-stamp strong {
  font-family: Georgia, serif;
  font-size: 16px;
  font-weight: 400;
}

.ticket-stamp small {
  position: absolute;
  bottom: 25px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 7px;
  letter-spacing: .18em;
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.ticket-description {
  position: relative;
  z-index: 3;
  max-width: 680px;
  margin-top: 22px;
}

.ticket-description p {
  margin: 0;
  color: #4f565d;
  font-size: 12px;
  line-height: 1.65;
}

.ticket-read-more {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-top: 10px;
  padding: 0;
  color: var(--vl-red);
  background: transparent;
  cursor: pointer;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}


/* =========================================================
   META
   ========================================================= */

.ticket-meta {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  max-width: 700px;
  margin-top: 24px;
  border-top: 1px solid rgba(50,55,60,.14);
  border-bottom: 1px solid rgba(50,55,60,.14);
}

.ticket-meta > div {
  min-width: 0;
  padding: 13px 15px 12px 0;
  border-right: 1px solid rgba(50,55,60,.12);
}

.ticket-meta > div:not(:first-child) {
  padding-left: 15px;
}

.ticket-meta > div:last-child {
  border-right: 0;
}

.ticket-meta span,
.ticket-meta strong {
  display: block;
}

.ticket-meta span {
  margin-bottom: 5px;
  color: #8a9095;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.ticket-meta strong {
  color: #30363c;
  font-size: 11px;
  line-height: 1.35;
}


/* =========================================================
   AUTHOR / PROPOSAL
   ========================================================= */

.ticket-author {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 17px;
  color: #858b91;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
}

.ticket-author button {
