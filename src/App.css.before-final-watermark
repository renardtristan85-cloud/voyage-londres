/* =========================================================
   REGLAGE FINAL — FILIGRANE + TAMPON
   ========================================================= */

/* Le calque principal ne doit jamais être agrandi par le filigrane */
.ticket-card .ticket-main-layer {
  position: relative;
  min-width: 0;
  overflow: hidden;
}

/* Filigrane architectural : absolument positionné */
