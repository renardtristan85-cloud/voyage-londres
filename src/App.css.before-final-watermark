/* =========================================================
   TICKET PERFORATIONS
   ========================================================= */

.ticket-card {
  overflow: visible;
}

/* =========================================================
   TICKET — PERFORATIONS
   ========================================================= */

/* =========================================================
   TICKET — SÉCURITÉ / GUILLLOCHE PREMIUM
   ========================================================= */

.ticket-card {
  position: relative;
  isolation: isolate;
}

/* =========================================================
   FILIGRANE — BILLET PREMIUM
   ========================================================= */

.ticket-card .ticket-main-layer {
  position: relative;
  isolation: isolate;
}

/* Grande trame guillochée */
.ticket-card .ticket-main-layer::before {
  content: "";
  position: absolute;
  z-index: 0;
  pointer-events: none;

  width: 520px;
  height: 520px;
  right: -105px;
  top: -82px;

  opacity: .42;

  background:
    repeating-radial-gradient(
      ellipse at center,
      transparent 0 10px,
      rgba(72,78,86,.075) 10.7px 11.4px,
      transparent 12px 19px
    );

  border-radius: 50%;

  transform: rotate(17deg);

  mask-image:
    radial-gradient(
      ellipse at center,
      black 0%,
      black 52%,
      transparent 78%
    );
}

/* Médaillon de sécurité */
.ticket-card .ticket-main-layer::after {
  content: "";
  position: absolute;
  z-index: 0;
  pointer-events: none;

  width: 235px;
  height: 235px;
  right: 45px;
  top: 58px;

  border-radius: 50%;

  border:
    1px solid rgba(73,79,87,.11);

  box-shadow:
    0 0 0 5px rgba(255,255,255,.12),
    0 0 0 6px rgba(73,79,87,.075),
    0 0 0 12px rgba(255,255,255,.08),
    0 0 0 13px rgba(73,79,87,.045),
    0 0 0 24px rgba(255,255,255,.07),
    0 0 0 25px rgba(73,79,87,.035);

  background:
    repeating-radial-gradient(
      ellipse at center,
      transparent 0 8px,
      rgba(73,79,87,.035) 8.5px 9px,
      transparent 9.5px 16px
    );

  opacity: .9;
}

/* Contenu au-dessus du filigrane */
.ticket-card .ticket-content-layer {
  position: relative;
  z-index: 2;
}


/* =========================================================
   PANNEAU VOTE — SCEAU DE VOYAGE
   ========================================================= */

.ticket-vote-panel {
  position: relative;
  isolation: isolate;
  overflow: hidden;

  background:
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 8px,
      rgba(70,76,84,.018) 8px,
      rgba(70,76,84,.018) 9px
    ),
    linear-gradient(
      135deg,
      rgba(255,255,255,.35),
      rgba(231,229,222,.96)
    ) !important;
}

/* Anneaux du sceau */
.ticket-vote-panel::after {
  content: "";
  position: absolute;
  z-index: 0;

  width: 128px;
  height: 128px;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%)
    rotate(-12deg);

  border-radius: 50%;

  border:
    2px solid rgba(167,25,48,.24);

  box-shadow:
    0 0 0 5px transparent,
    0 0 0 6px rgba(167,25,48,.12),
    0 0 0 12px transparent,
    0 0 0 13px rgba(167,25,48,.16),
    0 0 0 22px transparent,
    0 0 0 23px rgba(167,25,48,.08),
    inset 0 0 0 7px transparent,
    inset 0 0 0 8px rgba(167,25,48,.08);

  opacity: .95;
  pointer-events: none;
}

/* Symbole central */
.ticket-vote-panel::before {
  content: "✦";

  position: absolute;
  z-index: 1;

  left: 50%;
  top: 50%;

  transform:
    translate(-50%, -50%)
    rotate(-12deg);

  font-family:
    "Fraunces",
    Georgia,
    serif;

  font-size: 34px;
  font-weight: 400;
  line-height: 1;

  color: rgba(167,25,48,.23);

  text-shadow:
    0 0 0 rgba(167,25,48,0);

  pointer-events: none;
}

/* Vote toujours parfaitement lisible */
.ticket-vote-panel > * {
  position: relative;
  z-index: 3;
}


/* =========================================================
   PETITE MARQUE DE SÉCURITÉ
   ========================================================= */

.ticket-card .ticket-main-layer {
  overflow: hidden;
}

.ticket-card .ticket-main-layer > .ticket-content-layer::before {
  content: "";

  position: absolute;
  pointer-events: none;

  width: 90px;
  height: 90px;

  left: 20px;
  bottom: 18px;

  border-radius: 50%;

  border:
    1px solid rgba(167,25,48,.07);

  box-shadow:
    0 0 0 5px rgba(167,25,48,.025),
    0 0 0 11px rgba(167,25,48,.018);
}

