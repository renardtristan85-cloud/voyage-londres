  color: rgba(70, 76, 84, .11) !important;
  opacity: 1 !important;

  transform: none !important;
}

.ticket-architecture-watermark svg {
  display: block !important;
  width: 100% !important;
  height: 100% !important;
}

/* Le contenu reste au-dessus */
.ticket-card .ticket-content-layer {
  position: relative;
  z-index: 3;
}


/* =========================================================
   TAMPON — VRAI ARRIERE-PLAN DU PANNEAU
   ========================================================= */

.ticket-vote-panel {
  position: relative !important;
  isolation: isolate;
  overflow: hidden !important;
}

/* On place le tampon derrière absolument tout le contenu */
.ticket-vote-seal {
  position: absolute !important;

  z-index: 0 !important;

  width: 150px !important;
  height: 150px !important;

  left: 50% !important;
  top: 50% !important;

  margin: 0 !important;

  transform:
    translate(-50%, -50%)
    rotate(-10deg) !important;

  pointer-events: none !important;

  color: rgba(155, 25, 47, .17) !important;

  opacity: 1 !important;
}

.ticket-vote-seal svg {
  display: block !important;

  width: 100% !important;
  height: 100% !important;

  fill: none !important;
  stroke: currentColor !important;
  stroke-width: 1.5 !important;
}

.ticket-vote-seal text {
  fill: currentColor !important;
  stroke: none !important;

  font-family: "IBM Plex Mono", monospace !important;
  font-size: 18px !important;
  font-weight: 600 !important;
  letter-spacing: 3px !important;
}

.ticket-vote-seal .seal-year {
  font-size: 8px !important;
  letter-spacing: 2px !important;
}

/* Absolument tout le vote au-dessus du tampon */
.ticket-vote-content {
  position: relative !important;
  z-index: 4 !important;
}

.ticket-vote-panel > *:not(.ticket-vote-seal) {
  position: relative;
  z-index: 4;
}


/* Mobile */
@media (max-width: 620px) {
  .ticket-architecture-watermark {
    width: 430px !important;
    height: 230px !important;
    right: -125px !important;
    bottom: 5px !important;
  }

  .ticket-vote-seal {
    width: 125px !important;
    height: 125px !important;
  }
}

