/* =========================================================
   GRAPHIC STAMP
   ========================================================= */

.ticket-stamp {
  position: absolute;
  top: 164px;
  right: 38px;
  z-index: 5;
  width: 108px;
  height: 108px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4px;
  border: 2px solid rgba(167,25,48,.42);
  border-radius: 50%;
  color: rgba(167,25,48,.68);
  transform: rotate(-13deg);
  opacity: .78;
  font-family: "IBM Plex Mono", monospace;
  font-weight: 700;
  letter-spacing: .04em;
  pointer-events: none;
}

.ticket-stamp::before {
  content: "";
  position: absolute;
  inset: 7px;
  border: 1px dashed rgba(167,25,48,.42);
  border-radius: 50%;
}

.ticket-stamp::after {
  content: "";
  position: absolute;
  inset: 14px;
  border: 1px solid rgba(167,25,48,.18);
  border-radius: 50%;
}

.ticket-stamp span {
  font-size: 9px;
}

.ticket-stamp strong {
  font-family: Georgia, serif;
  font-size: 16px;
  font-weight: 400;
}

.ticket-stamp small {
  position: absolute;
  bottom: 25px;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 7px;
  letter-spacing: .18em;
}


/* =========================================================
   DESCRIPTION
   ========================================================= */

.ticket-description {
  position: relative;
  z-index: 3;
  max-width: 680px;
  margin-top: 22px;
}

.ticket-description p {
  margin: 0;
  color: #4f565d;
  font-size: 12px;
  line-height: 1.65;
}

.ticket-read-more {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  margin-top: 10px;
  padding: 0;
  color: var(--vl-red);
  background: transparent;
  cursor: pointer;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}


/* =========================================================
   META
   ========================================================= */

.ticket-meta {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  max-width: 700px;
  margin-top: 24px;
  border-top: 1px solid rgba(50,55,60,.14);
  border-bottom: 1px solid rgba(50,55,60,.14);
}

.ticket-meta > div {
  min-width: 0;
  padding: 13px 15px 12px 0;
  border-right: 1px solid rgba(50,55,60,.12);
}

.ticket-meta > div:not(:first-child) {
  padding-left: 15px;
}

.ticket-meta > div:last-child {
  border-right: 0;
}

.ticket-meta span,
.ticket-meta strong {
  display: block;
}

.ticket-meta span {
  margin-bottom: 5px;
  color: #8a9095;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.ticket-meta strong {
  color: #30363c;
  font-size: 11px;
  line-height: 1.35;
}


/* =========================================================
   AUTHOR / PROPOSAL
   ========================================================= */

.ticket-author {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 17px;
  color: #858b91;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
}

.ticket-author button {
  padding: 5px 8px;
  color: var(--vl-red);
  background: transparent;
  border: 1px solid rgba(167,25,48,.25);
  cursor: pointer;
  font-size: 7px;
  letter-spacing: .10em;
  text-transform: uppercase;
}

.ticket-delete-confirm {
  display: inline-flex;
  align-items: center;
  gap: 6px;
}

.ticket-delete-confirm button {
  padding: 5px 8px;
}


/* =========================================================
   PERFORATION
   ========================================================= */

.ticket-perforation {
  position: absolute;
  top: 20px;
  bottom: 20px;
  right: 174px;
  z-index: 8;
  width: 1px;
  pointer-events: none;
}

.ticket-perforation::before {
  content: "";
  position: absolute;
  inset: 0;
  width: 1px;
  background:
    repeating-linear-gradient(
      to bottom,
      rgba(60,66,72,.48) 0 4px,
      transparent 4px 8px
    );
}

.ticket-perforation span {
  display: none;
}

.ticket-perforation div {
  display: none;
}


/* =========================================================
   CHOICE COUPON
   ========================================================= */


.ticket-choice {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 190px;
  min-width: 190px;
  min-height: 100%;
  box-sizing: border-box;
  padding: 28px 18px;
  overflow: hidden;
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,.5),
      rgba(218,218,214,.65)
    );
  border-left: 0;
}

.ticket-choice::before {
  content: "EUROSTAR";
  position: absolute;
  top: 50%;
  left: 50%;
  color: rgba(70,76,82,.045);
  font-family: "IBM Plex Mono", monospace;
  font-size: 42px;
  font-weight: 700;
  letter-spacing: .08em;
  transform: translate(-50%, -50%) rotate(-90deg);
  white-space: nowrap;
}

.ticket-choice::after {
  content: "";
  position: absolute;
  inset: 13px;
  border: 1px solid rgba(80,86,92,.12);
  pointer-events: none;
}

.ticket-choice-watermark {
  position: absolute;
  right: 12px;
  bottom: 8px;
  color: rgba(70,76,82,.07);
  font-family: "Fraunces", Georgia, serif;
  font-size: 120px;
  font-weight: 600;
  line-height: .7;
}

.ticket-choice-label {
  position: relative;
  z-index: 2;
  margin-bottom: 25px;
  padding-bottom: 9px;
  border-bottom: 1px solid rgba(50,55,60,.20);
  color: #343a40;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .19em;
}

.ticket-price {
  position: relative;
  z-index: 2;
  text-align: center;
}

.ticket-price strong {
  display: block;
  color: var(--vl-ink);
  font-family: "Fraunces", Georgia, serif;
  font-size: 27px;
  font-weight: 500;
}

.ticket-price span {
  display: block;
  margin-top: 5px;
  color: #858b91;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: .13em;
}


/* =========================================================
   VOTE AREA
   ========================================================= */

.ticket-votes {
  position: relative;
  z-index: 11;
  display: flex;
  flex-direction: column;
  width: 100%;
  max-width: 150px;
  box-sizing: border-box;
  gap: 7px;
  margin-top: 28px;
}

.ticket-votes button {
  position: relative;
  width: 100%;
  min-height: 35px;
  padding: 8px 10px;
  color: #30363c;
  background: rgba(255,255,255,.32);
  border: 1px solid rgba(60,66,72,.20);
  cursor: pointer;
  transition:
    background .2s ease,
    color .2s ease,
    border-color .2s ease,
    transform .2s ease;
}

.ticket-votes button:hover {
  transform: translateY(-1px);
  background: rgba(255,255,255,.72);
  border-color: rgba(60,66,72,.4);
}

.ticket-votes button:active {
  transform: translateY(0);
}

.ticket-votes button.selected,
.ticket-votes button[aria-pressed="true"] {
  color: white;
  background: var(--vl-red);
  border-color: var(--vl-red);
}

.ticket-choice .vote-label,
.ticket-choice .vote-icon {
  position: relative;
  z-index: 2;
}

.vote-label {
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.vote-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}


/* =========================================================
   VOTERS
   ========================================================= */

.ticket-voters {
  position: relative;
  z-index: 3;
  width: 100%;
  margin-top: 12px;
  text-align: center;
}

.ticket-voters,

/* =========================================================
   CHOICE LABEL
   ========================================================= */

.ticket-choice-label + .ticket-price {
  margin-top: 0;
}

.ticket-choice .ticket-votes::before {
  content: "";
  display: block;
  width: 32px;
  height: 1px;
  margin: 0 auto 12px;
  background: var(--vl-red);
}


/* =========================================================
   CATEGORY WATERMARKS
   ========================================================= */

.ticket-category-hebergement .ticket-engraving {
  opacity: .48;
}

.ticket-category-repas .ticket-engraving {
  transform: rotate(2deg);
}

.ticket-category-activites .ticket-engraving {
  transform: rotate(-2deg);
}

.ticket-category-dossier .ticket-engraving {
  opacity: .32;
}


/* =========================================================
   PROPOSAL TICKET
   ========================================================= */

.ticket-proposal {
  transform: rotate(.5deg);
}


/* =========================================================
   ADMIN BUTTON
   ========================================================= */

.voyage-admin-button {
  position: relative;
  z-index: 10;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  color: rgba(255,255,255,.7);
  background: transparent;
  border: 1px solid rgba(255,255,255,.18);
  cursor: pointer;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .13em;
  text-transform: uppercase;
  transition: .2s ease;
}

.voyage-admin-button:hover {
  color: white;
  border-color: rgba(255,255,255,.45);
  background: rgba(255,255,255,.05);
}


/* =========================================================
   DOSSIER / OTHER PANELS
   ========================================================= */

.voyage-tab-content > section,
.voyage-tab-content > div {
  min-width: 0;
}


/* =========================================================
   INPUTS
   ========================================================= */

input,
textarea,
select {
  border-radius: 0;
}

input,
textarea {
  color: var(--vl-ink);
  background: rgba(255,255,255,.75);
  border: 1px solid rgba(40,45,50,.20);
}

input::placeholder,
textarea::placeholder {
  color: #969ba0;
}

input:focus,
textarea:focus {
  border-color: rgba(167,25,48,.65);
}


