/* Désactivation des formes décoratives */
.ticket-engraving {
  display: none;
}

/* =========================================================
   TICKET PERFORATIONS
   ========================================================= */

.ticket-card {
  overflow: visible;
}

.ticket-card .ticket-main::before,
.ticket-card .ticket-main::after {
  content: "";
  position: absolute;
  top: 50%;
  width: 18px;
  height: 18px;
  transform: translateY(-50%);
  border-radius: 50%;
  background: #11151a;
  box-shadow:
    0 -22px 0 #11151a,
    0 22px 0 #11151a,
    0 -44px 0 #11151a,
    0 44px 0 #11151a,
    0 -66px 0 #11151a,
    0 66px 0 #11151a,
    0 -88px 0 #11151a,
    0 88px 0 #11151a;
  z-index: 20;
  pointer-events: none;
}

.ticket-card .ticket-main::before {
  left: -9px;
}

.ticket-card .ticket-main::after {
  right: -9px;
}

/* =========================================================
   TICKET — PERFORATIONS
   ========================================================= */

.ticket-card .ticket-notch {
  position: absolute;
  left: 50%;
  width: 14px;
  height: 14px;
  margin-left: -7px;
  border-radius: 50%;
  background: #f3f1ea;
  box-shadow: 0 0 0 1px rgba(16,20,25,0.13);
  z-index: 20;
  pointer-events: none;
}

.ticket-card .ticket-notch-top {
  top: -7px;
}

.ticket-card .ticket-notch-bottom {
  bottom: -7px;
}

/* =========================================================
   TICKET — SUPPRESSION DU DÉCOR SVG
   ========================================================= */

.ticket-card .ticket-engraving {
  display: none !important;
}
