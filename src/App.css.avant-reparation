/* =========================================================
   TICKET — OUTER SHELL
   ========================================================= */

.ticket-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 175px;
  width: min(100%, 1040px);
  min-height: 355px;
  margin: 0 auto 34px;
  overflow: hidden;
  color: var(--vl-ink);
  background:
    radial-gradient(
      ellipse at 15% 20%,
      rgba(255,255,255,.85),
      transparent 28%
    ),
    radial-gradient(
      ellipse at 85% 85%,
      rgba(0,0,0,.045),
      transparent 34%
    ),
    var(--vl-paper);
  border: 1px solid rgba(255,255,255,.72);
  border-radius: 7px;
  box-shadow: var(--vl-shadow);
  isolation: isolate;
}

/* paper grain */
.ticket-card::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 0;
  pointer-events: none;
  opacity: .20;
  background-image:
    radial-gradient(rgba(20,25,30,.45) .45px, transparent .55px),
    radial-gradient(rgba(255,255,255,.9) .4px, transparent .5px);
  background-size: 5px 5px, 7px 7px;
  background-position: 0 0, 2px 3px;
  mix-blend-mode: multiply;
}

/* security print */
.ticket-card::after {
  content: "";
  position: absolute;
  inset: 8px;
  z-index: 1;
  pointer-events: none;
  border: 1px solid rgba(80,86,92,.17);
  border-radius: 4px;
}


/* =========================================================
   INNER BORDER
   ========================================================= */

.ticket-inner-border {
  position: absolute;
  inset: 16px;
  z-index: 2;
  pointer-events: none;
  border: 1px solid rgba(87,93,99,.17);
  border-radius: 2px;
}

.ticket-inner-border::before {
  content: "";
  position: absolute;
  inset: 4px;
  border: 1px dashed rgba(120,125,130,.13);
}


/* =========================================================
   ENGRAVING / ARCHITECTURAL WATERMARK
   ========================================================= */

.ticket-engraving {
  position: absolute;
  z-index: 1;
  right: 185px;
  bottom: -40px;
  width: 500px;
  height: 340px;
  opacity: .40;
  pointer-events: none;
  overflow: hidden;
}

.ticket-engraving::before {
  content: "";
  position: absolute;
  left: 25px;
  right: 25px;
  bottom: 0;
  height: 190px;
  border-radius: 50% 50% 0 0;
  border: 1px solid rgba(105,110,116,.14);
  border-bottom: 0;
}

.ticket-engraving::after {
  content: "";
  position: absolute;
  inset: 0;
  background:
    repeating-linear-gradient(
      90deg,
      transparent 0 15px,
      rgba(100,105,110,.045) 16px,
      transparent 17px
    );
  mask-image: linear-gradient(to top, black, transparent 90%);
}

.ticket-engraving-circle {
  position: absolute;
  border-radius: 50%;
  border: 1px solid rgba(95,101,107,.16);
}

.ticket-engraving-circle-a {
  width: 270px;
  height: 270px;
  right: 70px;
  top: 35px;
}

.ticket-engraving-circle-b {
  width: 205px;
  height: 205px;
  right: 103px;
  top: 68px;
  border-style: dashed;
}

.ticket-engraving-lines {
  position: absolute;
  left: 10px;
  right: 10px;
  bottom: 65px;
  height: 95px;
  background:
    repeating-linear-gradient(
      175deg,
      transparent 0 10px,
      rgba(80,86,92,.13) 11px,
      transparent 12px
    );
  transform: perspective(300px) rotateX(45deg);
}

.ticket-engraving-arch {
  position: absolute;
  bottom: 38px;
  width: 160px;
  height: 125px;
  border: 1px solid rgba(80,86,92,.15);
  border-bottom: 0;
  border-radius: 100px 100px 0 0;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: .2em;
  color: rgba(70,76,82,.24);
  text-align: center;
  padding-top: 10px;
}

.ticket-engraving-arch::before,
.ticket-engraving-arch::after {
  content: "";
  position: absolute;
  bottom: 0;
  width: 1px;
  height: 100%;
  background: rgba(80,86,92,.10);
}

.ticket-engraving-arch::before {
  left: 28px;
}

.ticket-engraving-arch::after {
  right: 28px;
}

.ticket-engraving-arch-paris {
  left: 35px;
}

.ticket-engraving-arch-london {
  left: 210px;
}


