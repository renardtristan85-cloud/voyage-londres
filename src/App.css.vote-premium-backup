/* === FILIGRANES PAR CHAPITRE === */

.ticket-watermark {
  position: absolute;
  z-index: 0;
  right: 7%;
  top: 14%;
  width: 250px;
  height: 170px;
  pointer-events: none;
  opacity: 0.55;
  border: 1px solid rgba(78,85,93,0.035);
  border-radius: 50%;
  transform: rotate(-8deg);
}

.ticket-watermark::before,
.ticket-watermark::after {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(168,148,104,0.035);
  border-radius: 50%;
}

.ticket-watermark::after {
  inset: 28px;
  border-style: dashed;
  border-color: rgba(78,85,93,0.035);
}

/* Hébergement — façade / fenêtres */
.ticket-category-hebergement .ticket-watermark {
  background:
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 18px,
      rgba(78,85,93,0.025) 18px,
      rgba(78,85,93,0.025) 19px
    ),
    repeating-linear-gradient(
      0deg,
      transparent 0,
      transparent 25px,
      rgba(78,85,93,0.022) 25px,
      rgba(78,85,93,0.022) 26px
    );
}

/* Repas — motif guilloché */
.ticket-category-repas .ticket-watermark {
  border-radius: 8px;
  background:
    repeating-radial-gradient(
      ellipse at center,
      transparent 0,
      transparent 9px,
      rgba(168,148,104,0.025) 10px,
      transparent 11px
    );
}

/* Activités — architecture / monument */
.ticket-category-activites .ticket-watermark {
  clip-path: polygon(
    8% 100%,
    8% 52%,
    22% 52%,
    22% 35%,
    31% 35%,
    31% 48%,
    42% 48%,
    42% 20%,
    50% 7%,
    58% 20%,
    58% 48%,
    69% 48%,
    69% 35%,
    78% 35%,
    78% 52%,
    92% 52%,
    92% 100%
  );
  border-radius: 0;
  border-top: 1px solid rgba(78,85,93,0.025);
}

/* Dossier — carte / réseau */
.ticket-category-dossier .ticket-watermark {
  border-radius: 0;
  transform: rotate(-12deg);
  background:
    linear-gradient(
      35deg,
      transparent 0 28%,
      rgba(78,85,93,0.025) 28.5%,
      transparent 29%
    ),
    linear-gradient(
      145deg,
      transparent 0 62%,
      rgba(168,148,104,0.025) 62.5%,
      transparent 63%
    ),
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 31px,
      rgba(78,85,93,0.018) 31px,
      rgba(78,85,93,0.018) 32px
    );
}

@media (max-width: 760px) {
  .ticket-watermark {
    right: 2%;
    top: 18%;
    width: 190px;
    height: 130px;
    opacity: 0.42;
  }
}
