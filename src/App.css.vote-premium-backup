.counter {
  font-size: 16px;
  padding: 5px 10px;
  border-radius: 5px;
  color: var(--accent);
  background: var(--accent-bg);
  border: 2px solid transparent;
  transition: border-color 0.3s;
  margin-bottom: 24px;

  &:hover {
    border-color: var(--accent-border);
  }
  &:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
}

.hero {
  position: relative;

  .base,
  .framework,
  .vite {
    inset-inline: 0;
    margin: 0 auto;
  }

  .base {
    width: 170px;
    position: relative;
    z-index: 0;
  }

  .framework,
  .vite {
    position: absolute;
  }

  .framework {
    z-index: 1;
    top: 34px;
    height: 28px;
    transform: perspective(2000px) rotateZ(300deg) rotateX(44deg) rotateY(39deg)
      scale(1.4);
  }

  .vite {
    z-index: 0;
    top: 107px;
    height: 26px;
    width: auto;
    transform: perspective(2000px) rotateZ(300deg) rotateX(40deg) rotateY(39deg)
      scale(0.8);
  }
}

#center {
  display: flex;
  flex-direction: column;
  gap: 25px;
  place-content: center;
  place-items: center;
  flex-grow: 1;

  @media (max-width: 1024px) {
    padding: 32px 20px 24px;
    gap: 18px;
  }
}

#next-steps {
  display: flex;
  border-top: 1px solid var(--border);
  text-align: left;

  & > div {
    flex: 1 1 0;
    padding: 32px;
    @media (max-width: 1024px) {
      padding: 24px 20px;
    }
  }

  .icon {
    margin-bottom: 16px;
    width: 22px;
    height: 22px;
  }

  @media (max-width: 1024px) {
    flex-direction: column;
    text-align: center;
  }
}

#docs {
  border-right: 1px solid var(--border);

  @media (max-width: 1024px) {
    border-right: none;
    border-bottom: 1px solid var(--border);
  }
}

#next-steps ul {
  list-style: none;
  padding: 0;
  display: flex;
  gap: 8px;
  margin: 32px 0 0;

  .logo {
    height: 18px;
  }

  a {
    color: var(--text-h);
    font-size: 16px;
    border-radius: 6px;
    background: var(--social-bg);
    display: flex;
    padding: 6px 12px;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    transition: box-shadow 0.3s;

    &:hover {
      box-shadow: var(--shadow);
    }
    .button-icon {
      height: 18px;
      width: 18px;
    }
  }

  @media (max-width: 1024px) {
    margin-top: 20px;
    flex-wrap: wrap;
    justify-content: center;

    li {
      flex: 1 1 calc(50% - 8px);
    }

    a {
      width: 100%;
      justify-content: center;
      box-sizing: border-box;
    }
  }
}

#spacer {
  height: 88px;
  border-top: 1px solid var(--border);
  @media (max-width: 1024px) {
    height: 48px;
  }
}

.ticks {
  position: relative;
  width: 100%;

  &::before,
  &::after {
    content: '';
    position: absolute;
    top: -4.5px;
    border: 5px solid transparent;
  }

  &::before {
    left: 0;
    border-left-color: var(--border);
  }
  &::after {
    right: 0;
    border-right-color: var(--border);
  }
}

/* === VOYAGE LONDRES — NOUVEAU TICKET PREMIUM === */

.ticket-card {
  position: relative;
  display: flex;
  overflow: hidden;
  min-height: 270px;
  border-radius: 2px;
  background:
    radial-gradient(circle at 18% 20%, rgba(168,148,104,0.055), transparent 25%),
    radial-gradient(circle at 82% 78%, rgba(120,130,140,0.045), transparent 28%),
    repeating-linear-gradient(
      0deg,
      rgba(16,20,25,0.012) 0px,
      rgba(16,20,25,0.012) 1px,
      transparent 1px,
      transparent 4px
    ),
    #f3f1ea !important;
  border: 1px solid rgba(16,20,25,0.16) !important;
  box-shadow:
    0 12px 30px rgba(16,20,25,0.08),
    2px 2px 0 rgba(16,20,25,0.035) !important;
}

.ticket-card::before {
  content: "";
  position: absolute;
  inset: 9px;
  pointer-events: none;
  border: 1px solid rgba(168,148,104,0.12);
  background:
    repeating-linear-gradient(
      90deg,
      transparent 0,
      transparent 22px,
      rgba(168,148,104,0.018) 22px,
      rgba(168,148,104,0.018) 23px
    );
}

.ticket-card > .flex-1 {
  position: relative;
  z-index: 1;
  padding: 30px 32px !important;
}

.ticket-card h3 {
  letter-spacing: -0.015em;
}

.ticket-card p {
  max-width: 58ch !important;
}

.ticket-card .ticket-divider-desktop {
  position: relative;
  z-index: 2;
  width: 1px;
  flex: 0 0 1px;
  margin: 22px 0;
  background: transparent;
}

.ticket-divider-line {
  position: absolute;
  inset: 0;
  width: 1px;
  background:
    repeating-linear-gradient(
      to bottom,
      rgba(16,20,25,0.25) 0px,
      rgba(16,20,25,0.25) 4px,
      transparent 4px,
      transparent 9px
    );
}

.ticket-card > .flex.flex-col.items-center {
  position: relative;
  z-index: 1;
  width: 224px;
  flex: 0 0 224px;
  background:
    linear-gradient(
      135deg,
      rgba(255,255,255,0.18),
      transparent 45%,
      rgba(168,148,104,0.035)
    ),
    #e8e6df !important;
  border-left: 0;
}

.ticket-card > .flex.flex-col.items-center::before {
  content: "YOUR CHOICE";
  position: absolute;
  top: 17px;
  left: 0;
  right: 0;
  text-align: center;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 2.2px;
  color: rgba(78,85,93,0.7);
}

.ticket-card > .flex.flex-col.items-center > div:first-child {
  margin-top: 14px;
}

.vote-button {
  width: 76px !important;
  height: 38px !important;
  border: 1px solid rgba(16,20,25,0.22) !important;
  border-radius: 1px !important;
  background: rgba(243,241,234,0.72) !important;
  color: #101419 !important;
  box-shadow: none !important;
  transition:
    background 140ms ease,
    border-color 140ms ease,
    transform 140ms ease;
}

.vote-button:hover:not(:disabled) {
  transform: translateY(-1px);
  border-color: rgba(16,20,25,0.42) !important;
}

.vote-button.active.vote-oui {
  background: #a71930 !important;
  border-color: #a71930 !important;
  color: #f3f1ea !important;
}

.vote-button.active.vote-non {
  background: #4e555d !important;
  border-color: #4e555d !important;
  color: #f3f1ea !important;
}

.ticket-card .ticket-notch {
  position: absolute;
  left: 50%;
  width: 14px;
  height: 14px;
  margin-left: -7px;
  border-radius: 50%;
  background: #f3f1ea;
  box-shadow: 0 0 0 1px rgba(16,20,25,0.13);
}

.ticket-card .ticket-notch-top {
  top: -7px;
}

.ticket-card .ticket-notch-bottom {
  bottom: -7px;
}

.ticket-divider-mobile {
  display: none;
}

@media (max-width: 760px) {
  .ticket-card {
    display: flex;
    flex-direction: column;
  }

  .ticket-card > .flex-1 {
    padding: 25px 22px !important;
  }

  .ticket-card > .flex.flex-col.items-center {
    width: 100%;
    flex: none;
    padding: 27px 20px 22px !important;
  }

  .ticket-card .ticket-divider-desktop {
    display: none;
  }

  .ticket-divider-mobile {
    display: block;
    position: relative;
    height: 1px;
    margin: 0 18px;
    background:
      repeating-linear-gradient(
        90deg,
        rgba(16,20,25,0.25) 0px,
        rgba(16,20,25,0.25) 4px,
        transparent 4px,
        transparent 9px
      );
  }

  .ticket-card > .flex.flex-col.items-center::before {
    top: 8px;
  }

  .ticket-card > .flex.flex-col.items-center > div:first-child {
    margin-top: 8px;
  }
}

