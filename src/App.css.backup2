/* =========================================================
   VOYAGE COVER
   ========================================================= */

.voyage-cover {
  position: relative;
  min-height: 680px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(255, 255, 255, 0.07),
      transparent 25%
    ),
    radial-gradient(
      circle at 80% 70%,
      rgba(167, 25, 48, 0.12),
      transparent 30%
    ),
    #11151a;
  color: #f4f1e9;
  isolation: isolate;
}

.voyage-cover::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.22;
  pointer-events: none;
  background-image:
    linear-gradient(
      115deg,
      transparent 0 48%,
      rgba(255,255,255,.08) 49%,
      transparent 50%
    ),
    linear-gradient(
      25deg,
      transparent 0 48%,
      rgba(255,255,255,.035) 49%,
      transparent 50%
    );
  background-size: 90px 90px, 130px 130px;
}

.voyage-cover::after {
  content: "PARIS  ·  LONDON  ·  PARIS  ·  LONDON  ·  EUROSTAR  ·  2028";
  position: absolute;
  left: -20%;
  right: -20%;
  bottom: 58px;
  transform: rotate(-4deg);
  color: rgba(255,255,255,.025);
  font-family: "IBM Plex Mono", monospace;
  font-size: 70px;
  letter-spacing: .08em;
  white-space: nowrap;
  pointer-events: none;
}

.voyage-cover-top,
.voyage-cover-main,
.voyage-cover-info {
  position: relative;
  z-index: 2;
}

.voyage-cover-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px clamp(24px, 6vw, 90px);
  border-bottom: 1px solid rgba(255,255,255,.12);
}

.voyage-cover-eyebrow {
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: rgba(255,255,255,.58);
}

.voyage-cover-main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 100px 28px 70px;
}

.voyage-cover-title {
  margin: 0;
  max-width: 850px;
  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(70px, 13vw, 180px);
  font-weight: 500;
  line-height: .78;
  letter-spacing: -.075em;
}

.voyage-cover-subtitle {
  margin-top: 30px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(255,255,255,.64);
}

.voyage-cover-route {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 54px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: .12em;
}

.voyage-cover-route::before {
  content: "";
  width: 70px;
  height: 1px;
  background: var(--vl-red);
}

.voyage-cover-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
  padding: 0 clamp(24px, 6vw, 90px) 45px;
}

.voyage-kicker {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.voyage-kicker-number {
  color: var(--vl-red);
}

.voyage-seal {
  width: 108px;
  height: 108px;
  border: 1px solid rgba(255,255,255,.34);
  border-radius: 50%;
  display: grid;
  place-items: center;
  position: relative;
  transform: rotate(-8deg);
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: .13em;
  text-align: center;
}

.voyage-seal::before,
.voyage-seal::after {
  content: "";
  position: absolute;
  border-radius: 50%;
}

.voyage-seal::before {
  inset: 7px;
  border: 1px dashed rgba(255,255,255,.3);
}

.voyage-seal::after {
  inset: 17px;
  border: 1px solid rgba(255,255,255,.15);
}


/* =========================================================
   TABS
   ========================================================= */

.voyage-tabs {
  display: flex;
  gap: 0;
  overflow-x: auto;
  background: #15191e;
  border-bottom: 1px solid rgba(255,255,255,.14) !important;
  scrollbar-width: none;
}

.voyage-tabs::-webkit-scrollbar {
  display: none;
}

.voyage-tab {
  position: relative;
  min-width: 190px;
  padding: 24px 24px 21px;
  color: rgba(255,255,255,.52);
  background: transparent;
  cursor: pointer;
  text-align: left;
  transition:
    color .25s ease,
    background .25s ease;
}

.voyage-tab::after {
  content: "";
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 0;
  height: 3px;
  background: var(--vl-red);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .25s ease;
}

.voyage-tab:hover {
  color: white;
  background: rgba(255,255,255,.035);
}

.voyage-tab.active {
  color: white;
  background: rgba(255,255,255,.045);
}

.voyage-tab.active::after {
  transform: scaleX(1);
}

.voyage-tab-number {
  display: block;
  margin-bottom: 8px;
  color: var(--vl-red);
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: .14em;
}

.voyage-tab-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.voyage-tab-label {
  font-family: "Fraunces", Georgia, serif;
  font-size: 20px;
  font-weight: 500;
}

.voyage-tab-subtitle {
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(255,255,255,.36);
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.voyage-tab-content {
  min-width: 0;
}

.ticket-category-hebergement,
.ticket-category-repas,
.ticket-category-activites,
.ticket-category-dossier {
  --category-mark: rgba(167, 25, 48, .08);
}

main {
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(255,255,255,.035),
      transparent 35%
    ),
    #171b20;
}

/* =========================================================
   PERFORATIONS — EXISTANTES, INCHANGÉES
   ========================================================= */

.ticket-card .ticket-notch {
  position: absolute;
  left: 0;
  width: 14px;
  height: 14px;
  margin-left: 0;
  transform: translateX(-50%);
  border-radius: 50%;
  background: #f3f1ea;
  box-shadow: 0 0 0 1px rgba(16,20,25,0.13);
  z-index: 20;
  pointer-events: none;
}

.ticket-card .ticket-notch-top {
  top: -7px;
}

.ticket-card .ticket-notch-bottom {
  bottom: -7px;
}

/* =========================================================
   PROPOSAL TICKET
   ========================================================= */

.ticket-proposal {
  transform: rotate(.5deg);
}


/* =========================================================
   ADMIN BUTTON
   ========================================================= */

.voyage-admin-button {
  position: relative;
  z-index: 10;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  color: rgba(255,255,255,.7);
  background: transparent;
  border: 1px solid rgba(255,255,255,.18);
  cursor: pointer;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .13em;
  text-transform: uppercase;
  transition: .2s ease;
}

.voyage-admin-button:hover {
  color: white;
  border-color: rgba(255,255,255,.45);
  background: rgba(255,255,255,.05);
}


/* =========================================================
   DOSSIER / OTHER PANELS
   ========================================================= */

.voyage-tab-content > section,
.voyage-tab-content > div {
  min-width: 0;
}


/* =========================================================
   INPUTS
   ========================================================= */

input,
textarea,
select {
  border-radius: 0;
}

input,
textarea {
  color: var(--vl-ink);
  background: rgba(255,255,255,.75);
  border: 1px solid rgba(40,45,50,.20);
}

input::placeholder,
textarea::placeholder {
  color: #969ba0;
}

input:focus,
textarea:focus {
  border-color: rgba(167,25,48,.65);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 820px) {
  .voyage-cover {
    min-height: 600px;
  }

  .voyage-cover-main {
    padding-top: 75px;
  }

  .voyage-cover-title {
    font-size: clamp(62px, 20vw, 120px);
  }

  .voyage-cover-info {
    align-items: flex-start;
  }

  .voyage-tabs {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .voyage-tab {
    min-width: 165px;
    padding-left: 18px;
    padding-right: 18px;
  }

  .voyage-tab::after {
    left: 18px;
    right: 18px;
  }

  .ticket-card {
    grid-template-columns: minmax(0, 1fr) 145px;
  }

  .ticket-main {
    padding: 27px 27px 27px;
  }

  .ticket-perforation {
    right: 144px;
  }

  .ticket-stamp {
    right: 28px;
  }
}


/* =========================================================
   PHONE
   ========================================================= */

@media (max-width: 620px) {
  body {
    background: #11151a;
  }

  .voyage-cover {
    min-height: 570px;
  }

  .voyage-cover-top {
    padding: 20px;
  }

  .voyage-cover-main {
    padding: 70px 20px 55px;
  }

  .voyage-cover-title {
    font-size: clamp(55px, 19vw, 95px);
  }

  .voyage-cover-subtitle {
    font-size: 9px;
    line-height: 1.6;
  }

  .voyage-cover-route {
    margin-top: 38px;
    font-size: 9px;
  }

  .voyage-cover-info {
    padding: 0 20px 30px;
  }

  .voyage-seal {
    width: 76px;
    height: 76px;
    font-size: 7px;
  }

  .voyage-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: visible;
  }

  .voyage-tab {
    min-width: 0;
    padding: 17px 14px;
    border-right: 1px solid rgba(255,255,255,.08);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  .voyage-tab::after {
    left: 14px;
    right: 14px;
  }

  .voyage-tab-label {
    font-size: 16px;
  }

  .voyage-tab-subtitle {
    font-size: 7px;
  }

  .ticket-card {
    display: block;
    width: calc(100% - 22px);
    margin-bottom: 25px;
  }

  .ticket-card::after {
    inset: 6px;
  }

  .ticket-inner-border {
    inset: 12px;
  }

  .ticket-main {
    padding: 25px 20px 22px;
  }

  .ticket-header-top {
    font-size: 7px;
  }

  .ticket-title-row {
    gap: 10px;
  }

  .ticket-title-row h3 {
    font-size: 29px;
    padding-right: 0;
  }

  .ticket-proposal {
    display: none;
  }

  .ticket-route-graphic {
    margin-top: 26px;
  }

  .ticket-route-label {
    grid-template-columns: auto minmax(60px, 1fr) auto;
    gap: 9px;
    font-size: 8px;
  }

  .ticket-route-center > span {
    font-size: 6px;
  }

  .ticket-route-date {
    font-size: 7px;
  }

  .ticket-stamp {
    top: 150px;
    right: 20px;
    width: 82px;
    height: 82px;
    opacity: .52;
  }

  .ticket-stamp span {
    font-size: 7px;
  }

  .ticket-stamp strong {
    font-size: 12px;
  }

  .ticket-stamp small {
    bottom: 19px;
    font-size: 6px;
  }

  .ticket-description {
    padding-right: 0;
  }

  .ticket-description p {
    font-size: 11px;
  }

  .ticket-meta {
    grid-template-columns: 1fr;
  }

  .ticket-meta > div,
  .ticket-meta > div:not(:first-child) {
    padding: 10px 0;
    border-right: 0;
    border-bottom: 1px solid rgba(50,55,60,.10);
  }

  .ticket-meta > div:last-child {
    border-bottom: 0;
  }




.vote-icon {
  font-size: 12px;
  line-height: 1;
}

.ticket-voters {
  position: relative;

  width: 100%;

  margin-top: 17px;
  padding-top: 12px;

  border-top: 1px solid rgba(65,72,79,.15);

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  line-height: 1.55;

  text-align: center;

  color: #697078;
}

.ticket-voters > div {
  margin-bottom: 7px;
}

.ticket-voters b,
.ticket-voters span {
  display: block;
}

.ticket-voters b {
  margin-bottom: 2px;

  font-size: 7px;
  letter-spacing: 1px;

  color: #4e555d;
}

.ticket-coupon-code {
  position: absolute;

  left: 50%;
  bottom: 20px;

  transform: translateX(-50%);

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 700;

  letter-spacing: 2px;

  color: #7a8087;
}

/* =========================================================
   CATEGORY VARIATIONS
   ========================================================= */

.ticket-category-hebergement .ticket-paris,
.ticket-category-hebergement .ticket-london {
  opacity: .72;
}

.ticket-category-repas .ticket-security-circles circle {
  stroke-dasharray: 4 7;
}

.ticket-category-activites .ticket-monument {
  opacity: 1;
}

.ticket-category-dossier .ticket-guilloche path {
  stroke: rgba(105,112,120,.13);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 820px) {

  .ticket-card {
    grid-template-columns: minmax(0, 1fr) 150px;
    min-height: 370px;
  }

  .ticket-perforation {
    right: 150px;
  }

  .ticket-main {
    padding: 29px 27px;
  }

  .ticket-header-top {
    font-size: 8px;
  }

  .ticket-route-label {
    grid-template-columns: 75px minmax(80px, 1fr) 75px;
    gap: 10px;
  }

  .ticket-stamp {
    right: 180px;
    top: 230px;
    width: 68px;
    height: 68px;
  }

}
