  }

  .voyage-tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    overflow: visible;
  }

  .voyage-tab {
    min-width: 0;
    padding: 17px 14px;
    border-right: 1px solid rgba(255,255,255,.08);
    border-bottom: 1px solid rgba(255,255,255,.08);
  }

  .voyage-tab::after {
    left: 14px;
    right: 14px;
  }

  .voyage-tab-label {
    font-size: 16px;
  }

  .voyage-tab-subtitle {
    font-size: 7px;
  }

  .ticket-card {
    display: block;
    width: calc(100% - 22px);
    margin-bottom: 25px;
  }

  .ticket-card::after {
    inset: 6px;
  }

  .ticket-inner-border {
    inset: 12px;
  }

  .ticket-main {
    padding: 25px 20px 22px;
  }

  .ticket-header-top {
    font-size: 7px;
  }

  .ticket-title-row {
    gap: 10px;
  }

  .ticket-title-row h3 {
    font-size: 29px;
    padding-right: 0;
  }

  .ticket-proposal {
    display: none;
  }

  .ticket-route-graphic {
    margin-top: 26px;
  }

  .ticket-route-label {
    grid-template-columns: auto minmax(60px, 1fr) auto;
    gap: 9px;
    font-size: 8px;
  }

  .ticket-route-center > span {
    font-size: 6px;
  }

  .ticket-route-date {
    font-size: 7px;
  }

  .ticket-stamp {
    top: 150px;
    right: 20px;
    width: 82px;
    height: 82px;
    opacity: .52;
  }

  .ticket-stamp span {
    font-size: 7px;
  }

  .ticket-stamp strong {
    font-size: 12px;
  }

  .ticket-stamp small {
    bottom: 19px;
    font-size: 6px;
  }

  .ticket-description {
    padding-right: 0;
  }

  .ticket-description p {
    font-size: 11px;
  }

  .ticket-meta {
    grid-template-columns: 1fr;
  }

  .ticket-meta > div,
  .ticket-meta > div:not(:first-child) {
    padding: 10px 0;
    border-right: 0;
    border-bottom: 1px solid rgba(50,55,60,.10);
  }

  .ticket-meta > div:last-child {
    border-bottom: 0;
  }




.vote-icon {
