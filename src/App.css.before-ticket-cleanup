/* =========================================================
   VOYAGE COVER
   ========================================================= */

.voyage-cover {
  position: relative;
  min-height: 680px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 20% 20%,
      rgba(255, 255, 255, 0.07),
      transparent 25%
    ),
    radial-gradient(
      circle at 80% 70%,
      rgba(167, 25, 48, 0.12),
      transparent 30%
    ),
    #11151a;
  color: #f4f1e9;
  isolation: isolate;
}

.voyage-cover::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: 0.22;
  pointer-events: none;
  background-image:
    linear-gradient(
      115deg,
      transparent 0 48%,
      rgba(255,255,255,.08) 49%,
      transparent 50%
    ),
    linear-gradient(
      25deg,
      transparent 0 48%,
      rgba(255,255,255,.035) 49%,
      transparent 50%
    );
  background-size: 90px 90px, 130px 130px;
}

.voyage-cover::after {
  content: "PARIS  ·  LONDON  ·  PARIS  ·  LONDON  ·  EUROSTAR  ·  2028";
  position: absolute;
  left: -20%;
  right: -20%;
  bottom: 58px;
  transform: rotate(-4deg);
  color: rgba(255,255,255,.025);
  font-family: "IBM Plex Mono", monospace;
  font-size: 70px;
  letter-spacing: .08em;
  white-space: nowrap;
  pointer-events: none;
}

.voyage-cover-top,
.voyage-cover-main,
.voyage-cover-info {
  position: relative;
  z-index: 2;
}

.voyage-cover-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28px clamp(24px, 6vw, 90px);
  border-bottom: 1px solid rgba(255,255,255,.12);
}

.voyage-cover-eyebrow {
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: .24em;
  text-transform: uppercase;
  color: rgba(255,255,255,.58);
}

.voyage-cover-main {
  max-width: 1100px;
  margin: 0 auto;
  padding: 100px 28px 70px;
}

.voyage-cover-title {
  margin: 0;
  max-width: 850px;
  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(70px, 13vw, 180px);
  font-weight: 500;
  line-height: .78;
  letter-spacing: -.075em;
}

.voyage-cover-subtitle {
  margin-top: 30px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: rgba(255,255,255,.64);
}

.voyage-cover-route {
  display: flex;
  align-items: center;
  gap: 20px;
  margin-top: 54px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 12px;
  letter-spacing: .12em;
}

.voyage-cover-route::before {
  content: "";
  width: 70px;
  height: 1px;
  background: var(--vl-red);
}

.voyage-cover-info {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 30px;
  padding: 0 clamp(24px, 6vw, 90px) 45px;
}

.voyage-kicker {
  display: flex;
  align-items: center;
  gap: 12px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: .16em;
  text-transform: uppercase;
}

.voyage-kicker-number {
  color: var(--vl-red);
}

.voyage-seal {
  width: 108px;
  height: 108px;
  border: 1px solid rgba(255,255,255,.34);
  border-radius: 50%;
  display: grid;
  place-items: center;
  position: relative;
  transform: rotate(-8deg);
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: .13em;
  text-align: center;
}

.voyage-seal::before,
.voyage-seal::after {
  content: "";
  position: absolute;
  border-radius: 50%;
}

.voyage-seal::before {
  inset: 7px;
  border: 1px dashed rgba(255,255,255,.3);
}

.voyage-seal::after {
  inset: 17px;
  border: 1px solid rgba(255,255,255,.15);
}


/* =========================================================
   TABS
   ========================================================= */

.voyage-tabs {
  display: flex;
  gap: 0;
  overflow-x: auto;
  background: #15191e;
  border-bottom: 1px solid rgba(255,255,255,.14) !important;
  scrollbar-width: none;
}

.voyage-tabs::-webkit-scrollbar {
  display: none;
}

.voyage-tab {
  position: relative;
  min-width: 190px;
  padding: 24px 24px 21px;
  color: rgba(255,255,255,.52);
  background: transparent;
  cursor: pointer;
  text-align: left;
  transition:
    color .25s ease,
    background .25s ease;
}

.voyage-tab::after {
  content: "";
  position: absolute;
  left: 24px;
  right: 24px;
  bottom: 0;
  height: 3px;
  background: var(--vl-red);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .25s ease;
}

.voyage-tab:hover {
  color: white;
  background: rgba(255,255,255,.035);
}

.voyage-tab.active {
  color: white;
  background: rgba(255,255,255,.045);
}

.voyage-tab.active::after {
  transform: scaleX(1);
}

.voyage-tab-number {
  display: block;
  margin-bottom: 8px;
  color: var(--vl-red);
  font-family: "IBM Plex Mono", monospace;
  font-size: 10px;
  letter-spacing: .14em;
}

.voyage-tab-content {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.voyage-tab-label {
  font-family: "Fraunces", Georgia, serif;
  font-size: 20px;
  font-weight: 500;
}

.voyage-tab-subtitle {
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .16em;
  text-transform: uppercase;
  color: rgba(255,255,255,.36);
}


/* =========================================================
   MAIN CONTENT
   ========================================================= */

.voyage-tab-content {
  min-width: 0;
}

.ticket-category-hebergement,
.ticket-category-repas,
.ticket-category-activites,
.ticket-category-dossier {
  --category-mark: rgba(167, 25, 48, .08);
}

main {
  background:
    radial-gradient(circle at 50% 0%, rgba(255,255,255,.035), transparent 35%),
    #171b20;
}

/* =========================================================
   TICKET — PREMIUM TRAVEL DOSSIER
   ========================================================= */

.ticket-card {
  position: relative;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 175px;

  width: min(100%, 1040px);
  min-height: 420px;
  margin: 0 auto 30px;

  overflow: hidden;

  background: #f2f1ea;
  color: #303238;

  border-radius: 5px;

  box-shadow:
    0 18px 45px rgba(0,0,0,.12),
    0 2px 8px rgba(0,0,0,.08);

  isolation: isolate;
}

/* Papier intérieur très léger */
.ticket-card::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  z-index: 1;

  background:
    repeating-linear-gradient(
      0deg,
      rgba(45,50,55,.012) 0,
      rgba(45,50,55,.012) 1px,
      transparent 1px,
      transparent 4px
    );
}

/* =========================================================
   MAIN LAYER
   ========================================================= */

.ticket-main-layer {
  position: relative;
  min-width: 0;
  min-height: 420px;
  overflow: hidden;

  background: #f2f1ea;
}

/* =========================================================
   ARCHITECTURAL ARTWORK
   ========================================================= */

.ticket-artwork {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 44%;

  pointer-events: none;
  z-index: 2;

  color: #7d8792;
  opacity: .62;
}

.ticket-artwork-svg {
  display: block;
  width: 100%;
  height: 100%;
}

.ticket-building {
  stroke-width: 1.05;
}

.ticket-journey-lines {
  fill: none;
  stroke: #aeb4ba;
  stroke-width: .8;
  opacity: .72;
}

.ticket-ground-lines {
  fill: none;
  stroke: #aeb4ba;
  stroke-width: .65;
  opacity: .55;
}

.ticket-building-paris,
.ticket-building-london {
  fill: none;
}

/* =========================================================
   CONTENT
   ========================================================= */

.ticket-content-layer {
  position: relative;
  z-index: 5;

  display: flex;
  flex-direction: column;

  min-height: 420px;
  padding: 22px 34px 22px;

  background: transparent;
}

/* Filigranes éditoriaux */
.ticket-content-layer::before,
.ticket-content-layer::after {
  content: "";
  position: absolute;
  pointer-events: none;
  z-index: -1;
}

/* Grande rosace de sécurité */
.ticket-content-layer::before {
  width: 250px;
  height: 250px;

  right: 13%;
  top: 150px;

  border: 1px solid rgba(93,104,114,.045);
  border-radius: 50%;

  box-shadow:
    0 0 0 14px rgba(93,104,114,.018),
    0 0 0 28px rgba(93,104,114,.014),
    0 0 0 42px rgba(93,104,114,.010);

  transform: rotate(14deg);
}

/* Filigrane orbital / trajectoire */
.ticket-content-layer::after {
  width: 430px;
  height: 125px;

  left: 7%;
  top: 185px;

  border-top: 1px solid rgba(93,104,114,.035);
  border-bottom: 1px solid rgba(93,104,114,.025);

  border-radius: 50%;

  transform: rotate(-8deg);
}

/* =========================================================
   TECHNICAL HEADER
   ========================================================= */

.ticket-content-layer {
  background-image:
    radial-gradient(
      circle at 72% 72%,
      rgba(93,104,114,.025) 0,
      rgba(93,104,114,.025) 1px,
      transparent 1.5px
    );
  background-size: 9px 9px;
}

.ticket-technical-header {
  display: flex;
  justify-content: space-between;
  align-items: center;

  position: relative;
  z-index: 6;

  padding-bottom: 9px;

  border-bottom: 1px solid rgba(80,88,96,.16);

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 600;
  letter-spacing: .16em;
  text-transform: uppercase;

  color: #707780;
}

/* =========================================================
   TITLE
   ========================================================= */

.ticket-title-area {
  position: relative;
  z-index: 6;

  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20px;

  margin-top: 102px;
}

.ticket-title-main {
  min-width: 0;
}

.ticket-title-main h3 {
  margin: 0;

  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(28px, 3vw, 39px);
  font-weight: 500;
  line-height: .98;
  letter-spacing: -.025em;

  color: #303238;
}

.ticket-address {
  display: flex;
  align-items: center;
  gap: 5px;

  margin-top: 9px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .04em;

  color: #687079;
}

.ticket-address svg {
  flex: 0 0 auto;
}

.ticket-proposal-mark {
  flex: 0 0 auto;

  margin-top: 4px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: .14em;

  color: #8b3036;
}

/* =========================================================
   ROUTE
   ========================================================= */

.ticket-main-route {
  position: relative;
  z-index: 6;

  display: flex;
  gap: 18px;

  margin-top: 15px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;

  color: #59616a;
}

.ticket-main-route span + span::before {
  content: "·";
  margin-right: 18px;
  color: #a1a6ab;
}

/* =========================================================
   DESCRIPTION
   ========================================================= */

.ticket-description-block {
  position: relative;
  z-index: 6;

  max-width: 610px;
  margin-top: 15px;
}

.ticket-description-block p {
  margin: 0;

  font-family: "Fraunces", Georgia, serif;
  font-size: 13px;
  line-height: 1.45;

  color: #555b62;
}

.ticket-read-more {
  margin-top: 7px;
  padding: 0;

  border: 0;
  background: transparent;

  cursor: pointer;

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;

  color: #8a3037;
}

/* =========================================================
   META
   ========================================================= */

.ticket-meta-block {
  position: relative;
  z-index: 6;

  display: flex;

  margin-top: 15px;

  border-top: 1px solid rgba(65,72,79,.13);
  border-bottom: 1px solid rgba(65,72,79,.13);
}

.ticket-meta-block > div {
  flex: 1;
  min-width: 0;

  display: flex;
  flex-direction: column;
  gap: 4px;

  padding: 8px 12px 8px 0;

  border-right: 1px solid rgba(65,72,79,.11);
}

.ticket-meta-block > div + div {
  padding-left: 12px;
}

.ticket-meta-block > div:last-child {
  border-right: 0;
}

.ticket-meta-block span:first-child {
  font-family: "IBM Plex Mono", monospace;
  font-size: 6px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: #92989e;
}

.ticket-meta-block span:last-child {
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  color: #4e555d;
}

/* =========================================================
   AUTHOR
   ========================================================= */

.ticket-author-row {
  position: relative;
  z-index: 6;

  display: flex;
  align-items: center;
  gap: 12px;

  margin-top: 9px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;

  color: #777e85;
}

.ticket-author-row button {
  padding: 0;

  border: 0;
  background: transparent;

  cursor: pointer;

  font-family: inherit;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;

  color: #8b3036;
}

.ticket-delete-confirm {
  display: inline-flex;
  align-items: center;
  gap: 7px;
}

/* =========================================================
   COUPON
   ========================================================= */

.ticket-coupon {
  position: relative;
  z-index: 6;

  margin-top: auto;
  padding-top: 12px;
}

.ticket-coupon::before {
  content: "";

  position: absolute;
  top: 0;
  left: 0;
  right: 0;

  border-top: 1px dashed rgba(75,82,89,.22);
}

.ticket-coupon-topline,
.ticket-coupon-bottomline {
  display: flex;
  justify-content: space-between;
  align-items: center;

  font-family: "IBM Plex Mono", monospace;
  font-size: 6px;
  font-weight: 700;
  letter-spacing: .15em;
  text-transform: uppercase;

  color: #858c93;
}

.ticket-coupon-route {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12px;

  margin: 6px 0 5px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  font-weight: 700;
  letter-spacing: .12em;

  color: #555c64;
}

.ticket-coupon-arrow {
  font-size: 12px;
  color: #8b3036;
}

/* =========================================================
   DIVIDER
   ========================================================= */

/* EXISTANT — STRUCTURE CONSERVÉE */
.ticket-divider-desktop {
  position: absolute;
  top: 0;
  bottom: 0;
  right: 175px;
  width: 1px;
  z-index: 18;

  pointer-events: none;
}

.ticket-divider-line {
  position: absolute;
  top: 18px;
  bottom: 18px;
  left: 0;

  border-left: 1px dashed rgba(72,79,87,.22);
}

.ticket-divider-mobile {
  display: none;
}

/* =========================================================
   PERFORATIONS — INCHANGÉES
   ========================================================= */

.ticket-card .ticket-notch {
  position: absolute;

  /* centre exactement sur la séparation principale / vote */
  left: auto;
  right: 175px;

  width: 14px;
  height: 14px;
  margin-right: -7px;

  border-radius: 50%;
  background: #f3f1ea;

  box-shadow:
    0 0 0 1px rgba(16,20,25,.13);

  z-index: 20;
  pointer-events: none;
}

.ticket-card .ticket-notch-top {
  top: -7px;
}

.ticket-card .ticket-notch-bottom {
  bottom: -7px;
}

/* =========================================================
   VOTE PANEL
   ========================================================= */

.ticket-vote-panel {
  position: relative;
  z-index: 8;

  display: flex;
  flex-direction: column;
  align-items: center;

  min-width: 0;
  padding: 38px 18px 25px;

  background:
    linear-gradient(
      90deg,
      rgba(45,50,55,.025),
      rgba(255,255,255,.08)
    );
}

.ticket-vote-seal {
  width: 142px;
  height: 142px;

  flex: 0 0 auto;

  color: rgba(112,32,32,.66);
  opacity: 1;
}

.ticket-vote-seal svg {
  display: block;
  width: 100%;
  height: 100%;
}

.ticket-vote-seal .seal-arc-text,
.ticket-vote-seal .seal-main,
.ticket-vote-seal .seal-year {
  font-family: "IBM Plex Mono", monospace;
  fill: currentColor;
}

.ticket-vote-seal .seal-arc-text {
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 1.3px;
}

.ticket-vote-seal .seal-main {
  font-size: 20px;
  font-weight: 700;
  letter-spacing: 2px;
}

.ticket-vote-seal .seal-year {
  font-size: 7px;
  font-weight: 700;
  letter-spacing: 2px;
}

/* =========================================================
   VOTE CONTENT
   ========================================================= */

.ticket-vote-content {
  width: 100%;
  margin-top: 16px;

  text-align: center;
}

.ticket-vote-price {
  font-family: "Fraunces", Georgia, serif;
  font-size: 27px;
  font-weight: 500;
  line-height: 1;

  color: #303238;
}

.ticket-vote-price small {
  display: block;
  margin-top: 5px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 6px;
  font-weight: 700;
  letter-spacing: .16em;
  text-transform: uppercase;

  color: #858c93;
}

.ticket-vote-actions {
  display: flex;
  gap: 7px;

  margin-top: 16px;
}

.ticket-vote-actions button {
  min-width: 57px;
  padding: 8px 8px;

  border: 1px solid rgba(55,61,67,.22);
  border-radius: 2px;

  background: transparent;

  cursor: pointer;

  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  font-weight: 700;
  letter-spacing: .08em;

  color: #424950;

  transition:
    background .18s ease,
    color .18s ease,
    border-color .18s ease;
}

.ticket-vote-actions button:hover {
  background: #303238;
  color: #f2f1ea;
  border-color: #303238;
}

.ticket-vote-actions button:first-child {
  color: #7e2930;
  border-color: rgba(126,41,48,.3);
}

.ticket-vote-actions button:first-child:hover {
  background: #7e2930;
  color: #f2f1ea;
  border-color: #7e2930;
}

.ticket-voters {
  width: 100%;
  margin-top: 15px;
  padding-top: 10px;

  border-top: 1px solid rgba(65,72,79,.14);

  font-family: "IBM Plex Mono", monospace;
  font-size: 6px;
  line-height: 1.55;

  text-align: center;

  color: #747b82;
}

.ticket-voters > div {
  margin-bottom: 6px;
}

.ticket-voters b,
.ticket-voters span {
  display: block;
}

.ticket-voters b {
  margin-bottom: 2px;

  font-size: 6px;
  letter-spacing: .1em;

  color: #555c63;
}

/* =========================================================
   PROPOSAL
   ========================================================= */

.ticket-proposal {
  transform: rotate(.5deg);
}

/* =========================================================
   ADMIN BUTTON
   ========================================================= */
/* =========================================================
   ADMIN BUTTON
   ========================================================= */

.voyage-admin-button {
  position: relative;
  z-index: 10;
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 14px;
  color: rgba(255,255,255,.7);
  background: transparent;
  border: 1px solid rgba(255,255,255,.18);
  cursor: pointer;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: .13em;
  text-transform: uppercase;
  transition: .2s ease;
}

.voyage-admin-button:hover {
  color: white;
  border-color: rgba(255,255,255,.45);
  background: rgba(255,255,255,.05);
}


/* =========================================================
   DOSSIER / OTHER PANELS
   ========================================================= */

.voyage-tab-content > section,
.voyage-tab-content > div {
  min-width: 0;
}


/* =========================================================
   INPUTS
   ========================================================= */

input,
textarea,
select {
  border-radius: 0;
}

input,
textarea {
  color: var(--vl-ink);
  background: rgba(255,255,255,.75);
  border: 1px solid rgba(40,45,50,.20);
}

input::placeholder,
textarea::placeholder {
  color: #969ba0;
}

input:focus,
textarea:focus {
  border-color: rgba(167,25,48,.65);
}


/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 820px) {
  .voyage-cover {
    min-height: 600px;
  }

  .voyage-cover-main {
    padding-top: 75px;
  }

  .voyage-cover-title {
    font-size: clamp(62px, 20vw, 120px);
  }

  .voyage-cover-info {
    align-items: flex-start;
  }

  .voyage-tabs {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .voyage-tab {
    min-width: 165px;
    padding-left: 18px;
    padding-right: 18px;
  }

  .voyage-tab::after {
    left: 18px;
    right: 18px;
  }

  .ticket-card {
    grid-template-columns: minmax(0, 1fr) 145px;
  }

  .ticket-main {
    padding: 27px 27px 27px;
  }

  .ticket-perforation {
    right: 144px;
  }

  .ticket-stamp {
    right: 28px;
  }
}


