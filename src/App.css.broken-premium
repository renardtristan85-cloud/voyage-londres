/* =========================================================
   VOYAGE LONDRES — INTERFACE PREMIUM
   Couche visuelle unique
   ========================================================= */

:root {
  --vl-ink: #0c1015;
  --vl-ink-soft: #141a21;
  --vl-bone: #f2f0e9;
  --vl-paper: #e8e6df;
  --vl-silver: #c8ccd0;
  --vl-muted: #727983;
  --vl-red: #a71930;
  --vl-gold: #a89468;
  --vl-line: rgba(242,240,233,.12);
  --vl-dark-line: rgba(12,16,21,.13);
}

* {
  box-sizing: border-box;
}

body {
  background: var(--vl-ink);
}

/* ---------- Couverture ---------- */

.voyage-cover {
  position: relative;
  overflow: hidden;
  min-height: 410px;
  background:
    radial-gradient(circle at 78% 24%, rgba(168,148,104,.10), transparent 22%),
    radial-gradient(circle at 16% 75%, rgba(200,204,208,.035), transparent 25%),
    linear-gradient(135deg, #0b0f14 0%, #11171e 58%, #0b0f14 100%);
}

.voyage-cover::before {
  content: "";
  position: absolute;
  inset: 18px;
  border: 1px solid rgba(200,204,208,.07);
  pointer-events: none;
}

.voyage-cover::after {
  content: "PARIS     LONDON     2028";
  position: absolute;
  right: -20px;
  bottom: -35px;
  font-family: "Fraunces", Georgia, serif;
  font-size: clamp(80px, 14vw, 170px);
  font-weight: 700;
  letter-spacing: -.05em;
  color: rgba(242,240,233,.018);
  white-space: nowrap;
  pointer-events: none;
}

.voyage-cover-top,
.voyage-cover-main,
.voyage-cover-info {
  position: relative;
  z-index: 2;
}

.voyage-cover-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.voyage-kicker {
  display: flex;
  flex-direction: column;
  gap: 5px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  line-height: 1.4;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: rgba(242,240,233,.46);
}

.voyage-kicker-number {
  color: rgba(168,148,104,.85);
}

.voyage-admin-button {
  padding: 8px 11px;
  border: 1px solid rgba(242,240,233,.12) !important;
  color: rgba(242,240,233,.58) !important;
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: 1px;
  text-transform: uppercase;
  cursor: pointer;
  transition: border-color .18s, color .18s;
}

.voyage-admin-button:hover {
  border-color: rgba(168,148,104,.55) !important;
  color: var(--vl-bone) !important;
}

.voyage-cover-main {
  display: grid;
  grid-template-columns: minmax(0,1fr) auto 230px;
  align-items: center;
  gap: 40px;
  margin-top: 70px;
}

.voyage-cover-eyebrow {
  margin-bottom: 13px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 3px;
  color: rgba(242,240,233,.38);
}

.voyage-cover-title h1 {
  margin: 0 !important;
  color: var(--vl-bone) !important;
  font-family: "Fraunces", Georgia, serif !important;
  font-size: clamp(48px, 7vw, 82px) !important;
  font-weight: 600 !important;
  line-height: .94 !important;
  letter-spacing: -.045em !important;
}

.voyage-cover-title h1 span {
  color: var(--vl-gold);
  font-weight: 400;
}

.voyage-cover-subtitle {
  margin-top: 18px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: 2px;
  color: rgba(242,240,233,.48);
}

.voyage-seal {
  position: relative;
  width: 92px;
  height: 92px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px solid rgba(168,148,104,.48);
  border-radius: 50%;
  color: rgba(168,148,104,.9);
  transform: rotate(-7deg);
}

.voyage-seal::before {
  content: "";
  position: absolute;
  inset: 6px;
  border: 1px dashed rgba(168,148,104,.25);
  border-radius: 50%;
}

.voyage-seal span {
  font-family: "Fraunces", Georgia, serif;
  font-size: 27px;
  line-height: 1;
}

.voyage-seal small {
  margin-top: 5px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: 2px;
}

.voyage-cover-route {
  justify-self: end;
  opacity: .85;
}

.voyage-cover-info {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 13px;
  margin-top: 60px;
  padding-top: 15px;
  border-top: 1px solid rgba(242,240,233,.10);
  font-family: "IBM Plex Mono", monospace;
  font-size: 7.5px;
  letter-spacing: 1.5px;
  color: rgba(242,240,233,.48);
}

.voyage-cover-info i {
  width: 3px;
  height: 3px;
  flex: 0 0 3px;
  border-radius: 50%;
  background: rgba(168,148,104,.65);
}

/* ---------- Timeline ---------- */

.voyage-timeline {
  position: relative;
  padding-top: 22px;
  padding-bottom: 25px;
  background: #10151b;
  border-bottom: 1px solid rgba(242,240,233,.07);
}

.voyage-timeline-heading {
  display: flex;
  justify-content: space-between;
  margin-bottom: 22px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: 2px;
  color: rgba(242,240,233,.34);
}

.voyage-timeline-heading span:last-child {
  color: rgba(168,148,104,.65);
}

.voyage-timeline-track {
  position: relative;
  display: grid;
  grid-template-columns: repeat(5,1fr);
}

.voyage-timeline-track::before {
  content: "";
  position: absolute;
  top: 4px;
  left: 1%;
  right: 1%;
  height: 1px;
  background: repeating-linear-gradient(
    90deg,
    rgba(242,240,233,.18) 0 4px,
    transparent 4px 10px
  );
}

.voyage-timeline-day {
  position: relative;
  min-width: 0;
}

.voyage-timeline-marker {
  position: relative;
  z-index: 1;
  width: 9px;
  height: 9px;
  margin-bottom: 12px;
  border: 1px solid rgba(242,240,233,.45);
  border-radius: 50%;
  background: #10151b;
}

.voyage-timeline-marker span {
  display: block;
  width: 3px;
  height: 3px;
  margin: 2px;
  border-radius: 50%;
  background: var(--vl-gold);
}

.voyage-timeline-day.terminal .voyage-timeline-marker {
  border-color: var(--vl-red);
}

.voyage-timeline-day.terminal:last-child .voyage-timeline-marker {
  background: var(--vl-red);
}

.voyage-timeline-date {
  margin-bottom: 5px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: 1.5px;
  color: rgba(168,148,104,.75);
}

.voyage-timeline-title {
  margin-bottom: 4px;
  font-family: "Fraunces", Georgia, serif;
  font-size: 14px;
  font-weight: 600;
  color: rgba(242,240,233,.88);
}

.voyage-timeline-detail {
  max-width: 155px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  line-height: 1.55;
  color: rgba(242,240,233,.32);
}

/* ---------- Navigation ---------- */

.voyage-tabs {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  background: #0c1015;
}

.voyage-tab {
  position: relative;
  display: flex;
  align-items: flex-start;
  gap: 13px;
  min-height: 82px;
  padding: 18px 20px;
  border: 0 !important;
  border-right: 1px solid rgba(242,240,233,.07) !important;
  background: transparent !important;
  color: rgba(242,240,233,.38);
  text-align: left;
  cursor: pointer;
  transition: background .18s, color .18s;
}

.voyage-tab:first-child {
  border-left: 1px solid rgba(242,240,233,.07) !important;
}

.voyage-tab::after {
  content: "";
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 0;
  height: 2px;
  background: transparent;
}

.voyage-tab.active {
  background: rgba(242,240,233,.035) !important;
  color: var(--vl-bone);
}

.voyage-tab.active::after {
  background: var(--vl-red);
}

.voyage-tab:hover:not(.active) {
  color: rgba(242,240,233,.72);
}

.voyage-tab-number {
  font-family: "IBM Plex Mono", monospace;
  font-size: 8px;
  letter-spacing: 1px;
  color: rgba(168,148,104,.72);
}

.voyage-tab-content {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.voyage-tab-label {
  display: flex;
  align-items: center;
  gap: 7px;
  font-family: "Fraunces", Georgia, serif;
  font-size: 17px;
  font-weight: 600;
  line-height: 1;
}

.voyage-tab-subtitle {
  font-family: "IBM Plex Mono", monospace;
  font-size: 6.5px;
  letter-spacing: 1.4px;
  color: rgba(242,240,233,.25);
}

.voyage-tab.active .voyage-tab-subtitle {
  color: rgba(242,240,233,.45);
}

/* ---------- Zone principale ---------- */

main {
  min-height: 500px;
}

/* ---------- Billet ---------- */

.ticket-card {
  position: relative;
  display: flex !important;
  width: 100%;
  min-height: 280px;
  overflow: hidden;
  border: 1px solid rgba(12,16,21,.14) !important;
  border-radius: 3px;
  background:
    radial-gradient(circle at 88% 18%, rgba(168,148,104,.07), transparent 28%),
    radial-gradient(circle at 8% 80%, rgba(114,121,131,.045), transparent 25%),
    #f2f0e9 !important;
  box-shadow: 0 18px 45px rgba(0,0,0,.13) !important;
}

.ticket-card::before {
  content: "";
  position: absolute;
  inset: 11px;
  z-index: 0;
  border: 1px solid rgba(168,148,104,.12);
  background:
    repeating-linear-gradient(
      115deg,
      transparent 0 30px,
      rgba(78,85,93,.014) 30px 31px
    );
  pointer-events: none;
}

.ticket-card::after {
  content: "PARIS × LONDON · EUROSTAR 9020 · 2028";
  position: absolute;
  z-index: 0;
  right: 25px;
  bottom: 13px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 6px;
  letter-spacing: 2px;
  color: rgba(78,85,93,.12);
  pointer-events: none;
}

.ticket-card > .flex-1 {
  position: relative;
  z-index: 1;
  min-width: 0;
  padding: 30px 34px !important;
}

.ticket-card h3 {
  margin: 0;
  color: #101419 !important;
  font-family: "Fraunces", Georgia, serif !important;
  font-size: 23px !important;
  font-weight: 600 !important;
  letter-spacing: -.025em;
}

.ticket-card p {
  color: #303740 !important;
  font-size: 14px !important;
  line-height: 1.65 !important;
}

/* En-tête du billet */

.ticket-header-premium {
  margin-bottom: 18px;
}

.ticket-header-top {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-bottom: 11px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 6.5px;
  letter-spacing: 1.5px;
  color: rgba(78,85,93,.62);
}

.ticket-header-top span:last-child {
  color: rgba(167,25,48,.78);
}

.ticket-header-rule {
  height: 1px;
  background: repeating-linear-gradient(
    90deg,
    rgba(16,20,25,.17) 0 5px,
    transparent 5px 9px
  );
}

.ticket-header-bottom {
  display: flex;
  justify-content: space-between;
  gap: 15px;
  margin-top: 15px;
  font-family: "IBM Plex Mono", monospace;
  font-size: 6.5px;
  letter-spacing: 1.2px;
  color: rgba(78,85,93,.52);
}

.ticket-header-bottom span:last-child {
  color: rgba(168,148,104,.88);
}

/* Trajet */

.ticket-route-premium {
  position: relative;
  margin-top: 18px;
  padding: 17px 0 13px;
  border-top: 1px solid rgba(16,20,25,.10);
  border-bottom: 1px solid rgba(16,20,25,.10);
}

.ticket-route-head {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 12px;
  align-items: center;
  font-family: "IBM Plex Mono", monospace;
  font-size: 9px;
  letter-spacing: 1.7px;
  color: #101419;
}

.ticket-route-head > span:last-child {
  text-align: right;
}

.ticket-route-date {
  color: var(--vl-gold);
  font-size: 7px;
}

.ticket-route-line {
  display: flex;
  align-items: center;
  gap: 7px;
  margin: 8px 0 2px;
}

.ticket-route-track {
  height: 1px;
  flex: 1;
  background: repeating-linear-gradient(
    90deg,
    rgba(16,20,25,.34) 0 4px,
    transparent 4px 8px
  );
}

.ticket-route-dot {
  width: 7px;
  height: 7px;
  flex: 0 0 7px;
  border: 1px solid #101419;
  border-radius: 50%;
  background: #f2f0e9;
}

.ticket-route-dot-end {
  border-color: var(--vl-red);
  background: var(--vl-red);
}

.ticket-route-codes {
  display: flex;
  justify-content: space-between;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: 1px;
  color: #727983;
}

.ticket-microprint {
  margin-top: 10px;
  overflow: hidden;
  white-space: nowrap;
  font-family: "IBM Plex Mono", monospace;
  font-size: 5.5px;
  letter-spacing: 1.4px;
  color: rgba(78,85,93,.35);
}

/* Filigrane */

.ticket-watermark {
  position: absolute;
  z-index: 0;
  right: 7%;
  top: 18%;
  width: 270px;
  height: 175px;
  border: 1px solid rgba(78,85,93,.035);
  border-radius: 50%;
  opacity: .65;
  pointer-events: none;
}

.ticket-watermark::before,
.ticket-watermark::after {
  content: "";
  position: absolute;
  inset: 13px;
  border: 1px solid rgba(168,148,104,.035);
  border-radius: 50%;
}

.ticket-watermark::after {
  inset: 31px;
  border-style: dashed;
}

/* ---------- Séparateur ---------- */

.ticket-divider-desktop {
  position: relative !important;
  z-index: 2;
  display: block !important;
  width: 1px !important;
  min-width: 1px !important;
  flex: 0 0 1px !important;
  align-self: stretch !important;
  margin: 20px 0 !important;
  background: repeating-linear-gradient(
    to bottom,
    rgba(16,20,25,.24) 0 5px,
    transparent 5px 10px
  );
}

.ticket-divider-line {
  display: none !important;
}

.ticket-card .ticket-notch {
  position: absolute !important;
  left: 50% !important;
  width: 15px !important;
  height: 15px !important;
  margin-left: -7.5px !important;
  border-radius: 50% !important;
  background: #0c1015 !important;
  box-shadow: 0 0 0 1px rgba(16,20,25,.12);
}

.ticket-card .ticket-notch-top {
  top: -7.5px !important;
}

.ticket-card .ticket-notch-bottom {
  bottom: -7.5px !important;
}

/* ---------- Colonne choix ---------- */

.ticket-card > .flex.flex-col.items-center {
  position: relative;
  z-index: 1;
  width: 224px !important;
  min-width: 224px !important;
  flex: 0 0 224px !important;
  padding: 34px 20px 24px !important;
  justify-content: center;
  background:
    linear-gradient(145deg, rgba(255,255,255,.30), transparent 60%),
    #e5e3dc !important;
}

.ticket-card > .flex.flex-col.items-center::before {
  content: "YOUR CHOICE";
  position: absolute;
  top: 15px;
  left: 0;
  right: 0;
  text-align: center;
  font-family: "IBM Plex Mono", monospace;
  font-size: 7px;
  letter-spacing: 2px;
  color: rgba(78,85,93,.55);
}

.ticket-card > .flex.flex-col.items-center > div:first-child {
  margin-top: 7px;
}

.vote-button {
  appearance: none !important;
  width: 78px !important;
  height: 39px !important;
  padding: 0 10px !important;
  border: 1px solid rgba(16,20,25,.22) !important;
  border-radius: 2px !important;
  background: rgba(242,240,233,.72) !important;
  color: #20262d !important;
  box-shadow: none !important;
  font-family: "IBM Plex Mono", monospace !important;
  font-size: 8px !important;
  font-weight: 500 !important;
  letter-spacing: 1.3px !important;
  text-transform: uppercase;
  transition: all .16s ease !important;
}

.vote-button:hover:not(:disabled) {
  transform: translateY(-1px);
  border-color: rgba(16,20,25,.48) !important;
}

.vote-button.active.vote-oui {
  background: var(--vl-red) !important;
  border-color: var(--vl-red) !important;
  color: var(--vl-bone) !important;
}

.vote-button.active.vote-non {
  background: #4e555d !important;
  border-color: #4e555d !important;
  color: var(--vl-bone) !important;
}

.vote-button:disabled {
  opacity: .42 !important;
}

/* ---------- Sections ---------- */

main > div > .section-title,
main .section-title {
  color: var(--vl-bone);
}

/* ---------- Mobile ---------- */

.ticket-divider-mobile {
  display: none;
}

@media (max-width: 767px) {
  .voyage-cover {
    min-height: 440px;
  }

  .voyage-cover-main {
    grid-template-columns: 1fr auto;
    gap: 20px;
    margin-top: 55px;
  }

  .voyage-cover-route {
    display: none;
  }

  .voyage-seal {
    width: 68px;
    height: 68px;
  }

  .voyage-seal span {
    font-size: 21px;
  }

  .voyage-cover-info {
    margin-top: 45px;
    gap: 8px;
    line-height: 1.7;
  }

  .voyage-tabs {
    grid-template-columns: repeat(2,1fr);
  }

  .voyage-tab {
    min-height: 70px;
    padding: 14px 13px;
  }

  .voyage-tab-label {
    font-size: 15px;
  }

  .voyage-tab-subtitle {
    font-size: 5.5px;
  }

  .voyage-timeline {
    overflow: hidden;
  }

  .voyage-timeline-track {
    display: flex;
    width: max-content;
    min-width: 100%;
    gap: 28px;
  }

  .voyage-timeline-day {
    width: 125px;
    flex: 0 0 125px;
  }

  .ticket-card {
    flex-direction: column !important;
  }

  .ticket-card > .flex-1 {
    padding: 25px 21px !important;
  }

  .ticket-card > .flex.flex-col.items-center {
    width: 100% !important;
    min-width: 0 !important;
    flex: none !important;
    padding: 29px 20px 22px !important;
  }

  .ticket-divider-desktop {
    display: none !important;
  }

  .ticket-divider-mobile {
    display: block !important;
    width: calc(100% - 36px);
    height: 1px;
    margin: 0 18px;
    background: repeating-linear-gradient(
      90deg,
      rgba(16,20,25,.25) 0 5px,
      transparent 5px 10px
    );
  }

  .ticket-watermark {
    width: 190px;
    height: 125px;
    right: 1%;
    top: 14%;
  }

  .ticket-header-top,
  .ticket-header-bottom {
    font-size: 6px;
  }
}
